msgstr "système de fichiers virtuel exportant des données de débogage du noyau arbitraires, sans garantie de stabilité ABI"

msgid "virtual filesystem holding ftrace control and trace-output files under /sys/kernel/tracing"
msgstr "système de fichiers virtuel contenant les fichiers de contrôle ftrace et de sortie des traces sous /sys/kernel/tracing"

msgid "virtual filesystem where userspace creates and configures kernel objects via mkdir and rmdir"
msgstr "système de fichiers virtuel où l'espace utilisateur crée et configure des objets du noyau via mkdir et rmdir"

