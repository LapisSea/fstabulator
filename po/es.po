msgstr "monta un directorio remoto a través de SSH usando SFTP, ejecutándose en espacio de usuario mediante FUSE"

msgid "standard filesystem format for CD-ROM optical media"
msgstr "formato estándar de sistema de archivos para medios ópticos CD-ROM"

msgid "Universal Disk Format for writable optical discs like DVDs and Blu-rays"
msgstr "formato universal de disco para discos ópticos grabables como DVD y Blu-ray"

msgid "virtual filesystem storing files in RAM and swap for temporary in-memory data"
msgstr "sistema de archivos virtual que almacena archivos en RAM y swap para datos temporales en memoria"

msgid "virtual filesystem exposing kernel and process information as files"
msgstr "sistema de archivos virtual que expone la información del kernel y de los procesos como archivos"

msgid "virtual filesystem exposing kernel objects, devices, and their attributes to userspace"
msgstr "sistema de archivos virtual que expone al espacio de usuario los objetos y dispositivos del kernel y sus atributos"

msgid "virtual filesystem providing pseudo-terminal device nodes under /dev/pts"
msgstr "sistema de archivos virtual que proporciona nodos de dispositivo de pseudo-terminal bajo /dev/pts"

msgid "virtual filesystem for the unified cgroup v2 hierarchy, managing resource limits and accounting"
msgstr "sistema de archivos virtual para la jerarquía unificada de cgroup v2, que gestiona los límites de recursos y la contabilidad"

msgid "virtual filesystem backing security modules such as SELinux and IMA integrity interfaces"
msgstr "sistema de archivos virtual que da soporte a módulos de seguridad como SELinux y a las interfaces de integridad IMA"

msgid "virtual filesystem exporting arbitrary kernel debugging data with no ABI stability guarantees"
msgstr "sistema de archivos virtual que exporta datos de depuración arbitrarios del kernel sin garantías de estabilidad de ABI"

msgid "virtual filesystem holding ftrace control and trace-output files under /sys/kernel/tracing"
msgstr "sistema de archivos virtual que contiene los archivos de control de ftrace y de salida de trazas bajo /sys/kernel/tracing"

msgid "virtual filesystem where userspace creates and configures kernel objects via mkdir and rmdir"
msgstr "sistema de archivos virtual donde el espacio de usuario crea y configura objetos del kernel mediante mkdir y rmdir"

msgid "POSIX message queue IPC exposed as files at /dev/mqueue"
msgstr "IPC de colas de mensajes POSIX expuesto como archivos en /dev/mqueue"

msgid "interface to huge page memory, mounted at /dev/hugepages"
msgstr "interfaz a la memoria de páginas enormes, montada en /dev/hugepages"

msgid "populates /dev with device nodes automatically at boot"
msgstr "rellena /dev con nodos de dispositivo automáticamente al arrancar"

msgid "Plan 9 remote filesystem protocol, used for host-to-VM file sharing"
msgstr "protocolo de sistema de archivos remoto de Plan 9 para compartir archivos entre el anfitrión y la VM"

msgid "union filesystem stacking upper/lower layers, used by containers"
msgstr "sistema de archivos union que apila capas superiores/inferiores, usado por contenedores"

msgid "OpenZFS copy-on-write filesystem with integrated volume management"
msgstr "sistema de archivos copy-on-write de OpenZFS con gestión integrada de volúmenes"

msgid "copy-on-write, multi-device filesystem with built-in caching, compression, and checksumming"
msgstr "sistema de archivos multi-dispositivo copy-on-write con caché, compresión y sumas de verificación integradas"

