msgstr "Minuten, in denen nach Fehlschlag wiederholt wird, bevor aufgegeben wird."

msgid "Maximum bytes per network read request."
msgstr "Maximale Anzahl an Bytes pro Netzwerk-Leseanfrage."

msgid "Maximum bytes per network write request."
msgstr "Maximale Anzahl an Bytes pro Netzwerk-Schreibanfrage."

msgid "Security flavors: none, sys, krb5, krb5i or krb5p."
msgstr "Sicherheitsmethoden: none, sys, krb5, krb5i oder krb5p."

