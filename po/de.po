msgstr "Verwendet die veraltete Client-ID-Zeichenfolge (Standard)."

msgid "NFSv4 protocol minor version number."
msgstr "Minorversionsnummer des NFSv4-Protokolls."

msgid "Hostname running the mountd service."
msgstr "Hostname des Rechners mit dem mountd-Dienst."

msgid "Port of the server's mountd service."
msgstr "Port des mountd-Dienstes des Servers."

