#, rust-format
msgid "Mount {mount_point}"
msgstr "Einhängen von {mount_point}"

msgid "Cannot mount"
msgstr "Nicht einhängbar"

msgid "A password is required."
msgstr "Ein Passwort ist erforderlich."

msgid "A credentials file name is required when saving credentials."
msgstr "Für das Speichern der Zugangsdaten ist ein Dateiname erforderlich."

msgid "Could not mount"
msgstr "Einhängen fehlgeschlagen"

#, rust-format
msgid "Would you like to delete the saved credentials file {path}?"
msgstr "Möchten Sie die gespeicherte Zugangsdatendatei {path} löschen?"

msgid "Credentials deleted"
msgstr "Zugangsdaten gelöscht"

msgid "The saved credentials file was deleted."
msgstr "Die gespeicherte Zugangsdatendatei wurde gelöscht."

msgid "Could not delete credentials"
msgstr "Zugangsdaten konnten nicht gelöscht werden"

msgid "Delete credentials"
msgstr "Zugangsdaten löschen"

msgid "login used for this mount only"
msgstr "Anmeldung nur für diese Einhängung"

#, rust-format
msgid "login saved to {path}"
msgstr "Anmeldung gespeichert unter {path}"

#. xgettext: keep the <b> markup tags intact
msgid "linked login to entry, <b>you must save changes to preserve this</b>"
msgstr "Anmeldung mit Eintrag verknüpft, <b>Sie müssen Ihre Änderungen speichern, um dies beizubehalten</b>"

#, rust-format
msgid "updated existing login in {path}"
msgstr "vorhandene Anmeldung in {path} aktualisiert"

#, rust-format
msgid "using existing login from {path}"
msgstr "vorhandene Anmeldung aus {path} wird verwendet"

#, rust-format
msgid "Mounted {mount_point}."
msgstr "{mount_point} wurde eingebunden."

msgid "Mounted"
msgstr "Eingebunden"

msgid "Username"
msgstr "Benutzername"

msgid "Password"
msgstr "Passwort"

msgid "Domain (optional)"
msgstr "Domäne (optional)"

msgid "Save for auto-mount"
msgstr "Für automatische Einhängung speichern"

msgid "Writes a credentials file referenced from the fstab entry."
msgstr "Erstellt eine Zugangsdatendatei, auf die der fstab-Eintrag verweist."

msgid "Credentials file"
msgstr "Zugangsdatendatei"

msgid "Load existing credentials"
msgstr "Vorhandene Zugangsdaten laden"

msgid "Will overwrite the existing file!"
msgstr "Die vorhandene Datei wird überschrieben!"

msgid "This filesystem may require credentials to mount."
msgstr "Dieses Dateisystem benötigt möglicherweise Zugangsdaten zum Einhängen."

msgid "Cancel"
msgstr "Abbrechen"

msgid "Connect"
msgstr "Verbinden"

#, rust-format
msgid "Could not resolve '{host}': {err}"
msgstr "'{host}' konnte nicht aufgelöst werden: {err}"

#, rust-format
msgid "Could not resolve '{host}'."
msgstr "'{host}' konnte nicht aufgelöst werden."

#, rust-format
msgid "Could not connect to {host}:{port}: {err}"
msgstr "Verbindung zu {host}:{port} fehlgeschlagen: {err}"

msgid "User"
msgstr "Benutzer"

msgid "Host"
msgstr "Host"

msgid "Port"
msgstr "Port"

msgid "Path"
msgstr "Pfad"

msgid "Test connection"
msgstr "Verbindung testen"

msgid "Network location"
msgstr "Netzwerkadresse"

msgid "Enter a valid port to test."
msgstr "Gültigen Port zum Testen eingeben."

msgid "Enter a host to test."
msgstr "Host zum Testen eingeben."

msgid "Testing connection…"
msgstr "Verbindung wird getestet…"

#, rust-format
msgid "Connected to {host}:{port}."
msgstr "Verbindung zu {host}:{port} hergestellt."

msgid "Test connection failed."
msgstr "Verbindungstest fehlgeschlagen."

msgid "Enter a host to save."
msgstr "Host zum Speichern eingeben."

msgid "Could not list devices"
msgstr "Fehler beim Auflisten der Geräte"

msgid "Filter devices…"
msgstr "Geräte filtern…"

msgid "No devices found"
msgstr "Keine Geräte gefunden"

#, rust-format
msgid "Select {kind}"
msgstr "{kind} auswählen"

msgid "Device name"
msgstr "Gerätename"

msgid "Size"
msgstr "Größe"

msgid "Label"
msgstr "Bezeichnung"

msgid "File System"
msgstr "Dateisystem"

msgid "Model"
msgstr "Modell"

msgid "Edit device"
msgstr "Gerät bearbeiten"

#, rust-format
msgid "Could not resolve a {kind} for {value}. The value was kept as-is."
msgstr "Konnte {kind} für {value} nicht auflösen. Der Wert wurde unverändert beibehalten."

msgid "Could not parse entry"
msgstr "Eintrag konnte nicht geparst werden"

#, rust-format
msgid "Mount point does not exist: {point}"
msgstr "Einhängepunkt existiert nicht: {point}"

#, rust-format
msgid "Unknown file system: {fs_type}"
msgstr "Unbekanntes Dateisystem: {fs_type}"

#, rust-format
msgid "Unknown option: {option}"
msgstr "Unbekannte Option: {option}"

msgid "No problems detected"
msgstr "Keine Probleme erkannt"

#, rust-format
msgid "Unknown device type: {device}"
msgstr "Unbekannter Gerätetyp: {device}"

#, rust-format
msgid "Device does not exist: {device}"
msgstr "Gerät existiert nicht: {device}"

#, rust-format
msgid "{option} should not have a value"
msgstr "{option} darf keinen Wert haben"

#, rust-format
msgid "{option} should be one of: {values}"
msgstr "{option} muss einer dieser Werte sein: {values}"

#, rust-format
msgid "{option} should be one of: {values}, optionally followed by a level"
msgstr "{option} muss einer dieser Werte sein: {values}, optional gefolgt von einer Stufe"

#, rust-format
msgid "{option} should be a number"
msgstr "{option} muss eine Zahl sein"

#, rust-format
msgid "{option} should be a number between {min} and {max}"
msgstr "{option} muss eine Zahl zwischen {min} und {max} sein"

#, rust-format
msgid "{option} should be an octal number"
msgstr "{option} muss eine oktale Zahl sein"

#, rust-format
msgid "{option} should be a number with a size unit, for example 16K"
msgstr "{option} muss eine Zahl mit einer Größeneinheit sein, zum Beispiel 16K"

#, rust-format
msgid "{option} should be {on} or {off}"
msgstr "{option} muss {on} oder {off} sein"

msgid "Edit as text"
msgstr "Als Text bearbeiten"

msgid "Edit the raw fstab line. Problems with its values are listed below."
msgstr "Die rohe fstab-Zeile bearbeiten. Probleme mit ihren Werten werden unten aufgeführt."

msgid "All I/O to the filesystem is done asynchronously."
msgstr "Der gesamte E/A auf dem Dateisystem erfolgt asynchron."

msgid "Update inode access time on every access."
msgstr "Inode-Zugriffszeit bei jedem Zugriff aktualisieren."

msgid "Can be mounted with the -a (mount all) option."
msgstr "Kann mit der Option -a (alle einhängen) eingehängt werden."

msgid "Remount a subtree elsewhere; mount only that subtree."
msgstr "Einen Teilbaum an anderer Stelle neu einhängen; nur diesen Teilbaum einhängen."

msgid "Comment field; ignored by the mount command."
msgstr "Kommentarfeld; wird vom mount-Befehl ignoriert."

msgid "Set the SELinux context for the whole filesystem."
msgstr "SELinux-Kontext für das gesamte Dateisystem festlegen."

msgid "Use default options: rw, suid, dev, exec, auto, nouser, async."
msgstr "Standardoptionen verwenden: rw, suid, dev, exec, auto, nouser, async."

msgid "Set the default SELinux context for unlabeled files."
msgstr "Standard-SELinux-Kontext für Dateien ohne Label festlegen."

msgid "Interpret character or block special devices on the filesystem."
msgstr "Zeichen- oder Blöckspezialgeräte auf dem Dateisystem interpretieren."

msgid "Update directory access times on reads."
msgstr "Zugriffszeiten von Verzeichnissen beim Lesen aktualisieren."

msgid "Make all directory updates synchronous."
msgstr "Alle Verzeichnisaktualisierungen synchron ausführen."

msgid "Permit execution of binaries on the filesystem."
msgstr "Ausführung von Binärdateien auf dem Dateisystem zulassen."

msgid "Set the SELinux context for the filesystem being mounted."
msgstr "SELinux-Kontext für das einzuhängende Dateisystem festlegen."

msgid "Allow mounting by a user whose group matches the device's group."
msgstr "Einhängen durch einen Benutzer erlauben, dessen Gruppe mit der Gerätegruppe übereinstimmt."

msgid "Increment the inode version on every inode modification."
msgstr "Inode-Version bei jeder Inode-Änderung erhöhen."

msgid "Update on-disk timestamps lazily, flushing them later."
msgstr "Zeitstempel auf der Platte träge aktualisieren und später schreiben."

msgid "Mount the file through a loop device."
msgstr "Die Datei über ein Loop-Gerät einhängen."

msgid "Turn off the silent flag (verbose errors)."
msgstr "Stiller Modus ausschalten (ausführliche Fehlermeldungen)."

msgid "Allow mandatory locking on the filesystem."
msgstr "Pflicht-Sperren auf dem Dateisystem zulassen."

msgid "Atomically move a mounted tree to a new location."
msgstr "Einen eingehängten Baum atomar an einen neuen Ort verschieben."

msgid "Do not update inode access times on reads."
msgstr "Inode-Zugriffszeiten beim Lesen nicht aktualisieren."

msgid "Can only be mounted explicitly, never with -a."
msgstr "Kann nur explizit eingehängt werden, niemals mit -a."

msgid "Do not interpret character or block special devices."
msgstr "Zeichen- oder Blöckspezialgeräte nicht interpretieren."

msgid "Do not update directory access times."
msgstr "Zugriffszeiten von Verzeichnissen nicht aktualisieren."

msgid "Do not permit execution of binaries on the filesystem."
msgstr "Ausführung von Binärdateien auf dem Dateisystem nicht zulassen."

msgid "Do not report errors if the device does not exist."
msgstr "Keine Fehler melden, wenn das Gerät nicht existiert."

msgid "Do not increment the inode version counter."
msgstr "Inode-Versionszähler nicht erhöhen."

msgid "Do not use the lazytime feature; flush timestamps at once."
msgstr "lazytime-Funktion nicht verwenden; Zeitstempel sofort nachschreiben."

msgid "Do not allow mandatory locking on the filesystem."
msgstr "Keine Pflichtsperren auf dem Dateisystem zulassen."

msgid "Do not use the relatime feature."
msgstr "relatime-Funktion nicht verwenden."

msgid "Do not honor setuid or setgid bits or file capabilities."
msgstr "setuid- oder setgid-Bits und Datei-Capabilities nicht berücksichtigen."

msgid "Do not follow symbolic links when resolving paths."
msgstr "Symbolische Links beim Auflösen von Pfaden nicht verfolgen."

msgid "Use the kernel's default access-time behavior."
msgstr "Standard-Zugriffszeitverhalten des Kernels verwenden."

msgid "Only root may mount the filesystem."
msgstr "Nur root kann das Dateisystem einhängen."

msgid "Mount only after the network is available."
msgstr "Erst nach Verfügbarkeit des Netzwerks einhängen."

msgid "Allow mounting by the owner of the device."
msgstr "Einhängen durch den Gerätebesitzer zulassen."

msgid "Make the mount private (no propagation to other mounts)."
msgstr "Einhang als privat markieren (keine Propagation auf andere Einhängen)."

msgid "Remount a subtree and all its submounts elsewhere."
msgstr "Subbaum und alle Untereinhänge an anderer Stelle neu einhängen."

msgid "Update access times relative to modify or change time."
msgstr "Zugriffszeiten relativ zur Änderungs- oder Statusänderungszeit aktualisieren."

msgid "Attempt to remount an already-mounted filesystem."
msgstr "Neueinhängen eines bereits eingehängten Dateisystems versuchen."

msgid "Mount the filesystem read-only."
msgstr "Dateisystem nur lesend einhängen."

msgid "Set the SELinux context of the filesystem's root inode."
msgstr "SELinux-Kontext des Root-Inodes des Dateisystems festlegen."

msgid "Make the mount and its submounts private."
msgstr "Einhang und dessen Untereinhang als privat markieren."

msgid "Make the mount and its submounts shared."
msgstr "Einhang und dessen Untereinhang als geteilt markieren."

msgid "Make the mount and its submounts slaves of their master."
msgstr "Einhang und dessen Untereinhang zu Sklaven ihres Masters machen."

msgid "Make the mount and its submounts unbindable."
msgstr "Einhang und dessen Untereinhang als nicht bindbar markieren."

msgid "Mount the filesystem read-write."
msgstr "Dateisystem lese- und schreibend einhängen."

msgid "Turn on the silent flag (suppress errors)."
msgstr "silent-Flag aktivieren (Fehler unterdrücken)."

msgid "Make the mount a slave of its master (receive propagation)."
msgstr "Einhang zu einem Sklaven seines Masters machen (Propagation empfangen)."

msgid "Make the mount shared with peer mounts."
msgstr "Den Einhang mit Peer-Einhängen teilen."

msgid "Update access times on every access (full atime)."
msgstr "Zugriffszeiten bei jedem Zugriff aktualisieren (volles atime)."

msgid "Honor setuid or setgid bits and file capabilities."
msgstr "setuid- oder setgid-Bits und Datei-Capabilities berücksichtigen."

msgid "All I/O to the filesystem is done synchronously."
msgstr "Alle E/A zum Dateisystem erfolgt synchron."

msgid "Make the mount unbindable."
msgstr "Einhang als nicht bindbar markieren."

msgid "Allow an ordinary user to mount the filesystem."
msgstr "Einhängen des Dateisystems durch normale Benutzer zulassen."

msgid "Allow every user to mount and unmount the filesystem."
msgstr "Ein- und Aushängen des Dateisystems durch alle Benutzer zulassen."

msgid "Restrict automatic filesystem detection to the listed types."
msgstr "Automatische Dateisystemerkennung auf die aufgelisteten Typen beschränken."

msgid "Set the group that may unmount the mount."
msgstr "Gruppe festlegen, die den Einhang aushängen darf."

msgid "Create an idmapped mount using the given ID mapping."
msgstr "idmapped-Einhang mit der angegebenen ID-Zuordnung erstellen."

msgid "Create the mountpoint directory if it does not exist."
msgstr "Einhängepunkt-Verzeichnis erstellen, falls es nicht existiert."

msgid "Set the mountpoint directory mode after mounting."
msgstr "Modus des Einhängepunkt-Verzeichnisses nach dem Einhängen festlegen."

msgid "Do not canonicalize mount source and target paths."
msgstr "Quell- und Zielpfade des Einhangs nicht kanonisieren."

msgid "Do not create a loop device even if the source is a regular file."
msgstr "Kein Loop-Gerät erstellen, auch wenn die Quelle eine reguläre Datei ist."

msgid "Set the owner that may unmount the mount."
msgstr "Besitzer festlegen, der den Einhang aushängen darf."

msgid "Mount a subdirectory of the filesystem instead of its root."
msgstr "Ein Unterverzeichnis des Dateisystems anstelle dessen Wurzel einhängen."

msgid "Enables POSIX access control lists."
msgstr "Aktiviert POSIX-Zugriffssteuerunglisten."

msgid "Disables POSIX access control lists."
msgstr "Deaktiviert POSIX-Zugriffssteuerunglisten."

msgid "statfs reports usable blocks minus filesystem overhead."
msgstr "statfs meldet nutzbare Blöcke abzüglich des Dateisystem-Overheads."

msgid "statfs reports total blocks including overhead."
msgstr "statfs meldet die Gesamtzahl der Blöcke einschließlich Overhead."

msgid "Performs mount-time checking; only check=none supported now."
msgstr "Führt eine Prüfung beim Einhängen durch; derzeit wird nur check=none unterstützt."

msgid "Skips checking at mount time (default)."
msgstr "Überspringt die Prüfung beim Einhängen (Standard)."

msgid "Prints debugging info upon each (re)mount."
msgstr "Gibt bei jedem (Neu-)Einhängen Debug-Informationen aus."

msgid "Sets behavior on errors: continue, remount-ro, or panic."
msgstr "Verhalten bei Fehlern festlegen: continue, remount-ro oder panic."

msgid "New files inherit the group ID of their parent directory."
msgstr "Neue Dateien erben die Gruppen-ID des übergeordneten Verzeichnisses."

msgid "Same as grpid."
msgstr "Gleich wie grpid."

msgid "New files take the creating process's fsgid (default)."
msgstr "Neue Dateien übernehmen die fsgid des erzeugenden Prozesses (Standard)."

msgid "Same as nogrpid."
msgstr "Entspricht nogrpid."

msgid "Enables group quota support."
msgstr "Aktiviert die Gruppenquoten."

msgid "Enables user quota support."
msgstr "Aktiviert die Benutzerquoten."

msgid "Enables user quota support (same as usrquota)."
msgstr "Aktiviert die Benutzerquoten (entspricht usrquota)."

msgid "Disables all quota support."
msgstr "Deaktiviert alle Quoten."

msgid "Disables 32-bit UIDs/GIDs for old-kernel compatibility."
msgstr "Deaktiviert 32-Bit-UIDs/GIDs zur Kompatibilität mit älteren Kerneln."

msgid "Uses the old inode allocator instead of Orlov."
msgstr "Verwendet den alten Inode-Allokator statt Orlov."

msgid "Uses the Orlov allocator for new inodes (default)."
msgstr "Verwendet den Orlov-Allokator für neue Inodes (Standard)."

msgid "Group ID allowed to use reserved filesystem blocks."
msgstr "Gruppen-ID, die reservierte Dateisystemblöcke verwenden darf."

msgid "User ID allowed to use reserved filesystem blocks."
msgstr "Benutzer-ID, die reservierte Dateisystemblöcke verwenden darf."

msgid "Mounts using an alternate superblock number (recovery)."
msgstr "Hängt mit alternativer Superblocknummer ein (Wiederherstellung)."

msgid "Enables \"user.\" extended attributes."
msgstr "Aktiviert die erweiterten Attribute „user.“"

msgid "Disables \"user.\" extended attributes."
msgstr "Deaktiviert die erweiterten Attribute „user.“"

msgid "Enables write barriers in the journal code."
msgstr "Aktiviert Schreibbarrieren im Journalcode."

msgid "Sets journal commit interval in seconds (default 5)."
msgstr "Setzt das Commit-Intervall des Journals in Sekunden (Standard: 5)."

msgid "Sets data journaling mode: journal, ordered, or writeback."
msgstr "Setzt den Journalisierungsmodus für Daten: journal, ordered oder writeback."

msgid "Action on data errors in ordered mode: abort or ignore."
msgstr "Verhalten bei Datenfehlern im ordered-Modus: abort oder ignore."

msgid "Sets the group quota database file for journaled quotas."
msgstr "Setzt die Gruppenquoten-Datenbankdatei für journalisierte Quoten."

msgid "Specifies external journal device by major/minor number."
msgstr "Gibt das externe Journalgerät anhand der Major-/Minor-Nummer an."

msgid "Specifies external journal device by device path."
msgstr "Gibt das externe Journalgerät anhand des Gerätpfads an."

msgid "Sets quota format: vfsold, vfsv0, or vfsv1."
msgstr "Setzt das Quota-Format: vfsold, vfsv0 oder vfsv1."

msgid "Does not load the journal on mount."
msgstr "Lädt das Journal beim Einhängen nicht."

msgid "Does not load the journal on mount (same as noload)."
msgstr "Lädt das Journal beim Einhängen nicht (entspricht noload)."

msgid "Sets the user quota database file for journaled quotas."
msgstr "Setzt die Benutzerquoten-Datenbankdatei für journalisierte Quoten."

msgid "Simulates an ext4_abort() for debugging purposes."
msgstr "Simuliert ext4_abort() zu Fehlersuchzwecken."

msgid "Forces delayed blocks to disk before rename/truncate commits."
msgstr "Erzwingt das Schreiben verzögerter Blöcke auf die Platte vor rename- und truncate-Commits."

msgid "Disables forced allocation on rename/truncate."
msgstr "Deaktiviert die erzwungene Allokation bei rename/truncate."

msgid "Tracks metadata blocks internally (debug; off by default)."
msgstr "Verfolgt Metadatenblöcke intern (Debug; standardmäßig deaktiviert)."

msgid "Disables internal metadata block tracking."
msgstr "Deaktiviert die interne Verfolgung von Metadatenblöcken."

msgid "Defers block allocation until write-out time."
msgstr "Verschiebt die Blockallokation bis zum Schreibvorgang."

msgid "Disables delayed allocation."
msgstr "Deaktiviert die verzögerte Allokation."

msgid "Uses inode mutex for DIO reads (default)."
msgstr "Verwendet das Inode-Mutex für DIO-Lesevorgänge (Standard)."

msgid "Avoids inode mutex for DIO reads for scalability."
msgstr "Vermeidet das Inode-Mutex für DIO-Lesevorgänge (Skalierung)."

msgid "Issues discard/TRIM commands when blocks are freed."
msgstr "Gibt discard/TRIM-Befehle aus, wenn Blöcke freigegeben werden."

msgid "Disables issuing discard/TRIM commands."
msgstr "Deaktiviert das Ausgeben von discard/TRIM-Befehlen."

msgid "Sets the case-insensitive lookup charset for casefolded directories (e.g. utf8-12.1)."
msgstr "Setzt den Zeichensatz für die case-insensitive Suche in casefold-Verzeichnissen (z. B. utf8-12.1)."

msgid "Sets flags controlling casefold behavior (e.g. strict)."
msgstr "Setzt Flags zur Steuerung des casefold-Verhaltens (z. B. strict)."

msgid "Enables fast commits, a lightweight journaling mode for lower commit latency."
msgstr "Aktiviert Fast Commits, einen leichtgewichtigen Journalisierungsmodus für geringere Commit-Latenz."

msgid "Tunes the lazy inode-table initialization speed."
msgstr "Stellt das Tempo der verzögerten Inode-Tabellen-Initialisierung ein."

msgid "Does not initialize inode tables in the background."
msgstr "Initialisiert die Inode-Tabellen nicht im Hintergrund."

msgid "Max inode table blocks pre-read during mount."
msgstr "Maximal vorab gelesene Inode-Tabellenblöcke beim Einhängen."

msgid "Enables 64-bit inode version support."
msgstr "Aktiviert die Unterstützung für 64-Bit-Inode-Versionen."

msgid "Writes commit block without waiting for descriptors."
msgstr "Schreibt den Commit-Block ohne Warten auf Deskriptoren."

msgid "Enables checksumming of journal transactions."
msgstr "Aktiviert die Prüfsummenbildung für Journaltransaktionen."

msgid "Disables journal transaction checksumming."
msgstr "Deaktiviert die Prüfsummenbildung für Journaltransaktionen."

msgid "Sets I/O priority for journal commits (0-7)."
msgstr "Setzt die I/O-Priorität für Journal-Commits (0-7)."

msgid "Max microseconds to wait to batch sync-write operations."
msgstr "Maximale Wartezeit in Mikrosekunden zum Bündeln von sync-Schreibvorgängen."

msgid "Limits maximum directory size in kilobytes."
msgstr "Begrenzt die maximale Verzeichnisgröße in Kilobyte."

msgid "Minimum commit time for batch optimization (us)."
msgstr "Minimale Commit-Zeit für die Batching-Optimierung (us)."

msgid "Disables write barriers."
msgstr "Deaktiviert Schreibbarrieren."

msgid "Disables mbcache for extended attribute deduplication."
msgstr "Deaktiviert mbcache für die Deduplizierung erweiterter Attribute."

msgid "Enables project quota support."
msgstr "Aktiviert die Projektquoten-Unterstützung."

msgid "Sets stripe width (blocks) for mballoc allocation alignment."
msgstr "Legt die Stripe-Breite (Blöcke) für die Allokationsausrichtung von mballoc fest."

msgid "Sets end-of-file preallocation size for buffered I/O."
msgstr "Legt die Preallocationsgröße am Dateiende für gepufferten I/O fest."

msgid "Enables opportunistic inline xattr format; deprecated since 5.10."
msgstr "Aktiviert das opportunistische Inline-xattr-Format; veraltet seit 5.10."

msgid "Disables attr2 format; deprecated, rejected on CRC filesystems."
msgstr "Deaktiviert das attr2-Format; veraltet, wird auf CRC-Dateisystemen abgelehnt."

msgid "Sets direct-access mode: never, always, or inode."
msgstr "Legt den Direktzugriffsmodus fest: never, always oder inode."

msgid "Issues commands to reclaim freed blocks (SSD-friendly)."
msgstr "Gibt Befehle zur Wiederaufbereitung freigegebener Blöcke aus (SSD-freundlich)."

msgid "Disables issuing discard commands."
msgstr "Deaktiviert das Senden von Discard-Befehlen."

msgid "Applies filestreams allocation mode to whole filesystem."
msgstr "Wendet den filestreams-Allokationsmodus auf das gesamte Dateisystem an."

msgid "Enables group quota accounting without enforcement."
msgstr "Aktiviert die Kontierung von Gruppenquoten ohne Durchsetzung."

msgid "Enables group quota accounting and enforcement."
msgstr "Aktiviert die Kontierung und Durchsetzung von Gruppenquoten."

msgid "Same as gquota."
msgstr "Entspricht gquota."

msgid "New files inherit the parent directory's group ID."
msgstr "Neue Dateien erben die Gruppen-ID des übergeordneten Verzeichnisses."

msgid "New files take the process's fsgid (default)."
msgstr "Neue Dateien übernehmen die fsgid des Prozesses (Standard)."

msgid "Keeps empty inode clusters on disk; deprecated since 5.10."
msgstr "Behält leere Inode-Cluster auf der Festplatte; veraltet seit 5.10."

msgid "Recycles empty inode clusters; deprecated since 5.10."
msgstr "Recycelt leere Inode-Cluster; veraltet seit 5.10."

msgid "Restricts inode numbers to 32 bits."
msgstr "Beschränkt Inode-Nummern auf 32 Bit."

msgid "Allows 64-bit inode numbers (default)."
msgstr "Erlaubt 64-Bit-Inode-Nummern (Standard)."

msgid "Reports swidth/allocsize as st_blksize."
msgstr "Gibt swidth/allocsize als st_blksize zurück."

msgid "Reports minimal st_blksize (default)."
msgstr "Gibt das minimale st_blksize zurück (Standard)."

msgid "Sets number of in-memory log buffers (2-8)."
msgstr "Legt die Anzahl der Log-Puffer im Speicher fest (2-8)."

msgid "Sets size of each in-memory log buffer."
msgstr "Legt die Größe jedes Log-Puffers im Speicher fest."

msgid "Uses an external log (metadata journal) device."
msgstr "Verwendet ein externes Gerät als Log (Metadata-Journal)."

msgid "Skips stripe-unit alignment for data allocations."
msgstr "Überspringt die Stripe-Einheit-Ausrichtung für Datenallokationen."

msgid "Mounts without running log recovery (read-only)."
msgstr "Mountet ohne Durchführung der Log-Wiederherstellung (nur lesend)."

msgid "Skips duplicate-UUID mount detection."
msgstr "Überspringt die Erkennung von UUID-Duplikaten."

msgid "Forcibly turns off all quota accounting and enforcement."
msgstr "Schaltet sämtliche Quota-Kontierung und -Durchsetzung zwangsweise aus."

msgid "Enables project quota accounting and enforcement."
msgstr "Aktiviert die Kontierung und Durchsetzung von Projektquoten."

msgid "Enables project quota accounting without enforcement."
msgstr "Aktiviert die Kontierung von Projektquoten ohne Durchsetzung."

msgid "Same as pquota."
msgstr "Entspricht pquota."

msgid "Enables user quota accounting without enforcement."
msgstr "Aktiviert die Kontierung von Benutzerquoten ohne Durchsetzung."

msgid "Enables user quota accounting and enforcement."
msgstr "Aktiviert die Kontierung und Durchsetzung von Benutzerquoten."

msgid "Uses an external realtime-section device."
msgstr "Verwendet ein externes Gerät für den Realtime-Bereich."

msgid "Sets stripe unit in 512-byte blocks."
msgstr "Legt die Stripe-Einheit in 512-Byte-Blöcken fest."

msgid "Rounds data allocations up to stripe-width boundaries."
msgstr "Rundet Datenallokationen auf Grenzen der Stripe-Breite auf."

msgid "Sets stripe width in 512-byte blocks."
msgstr "Legt die Stripe-Breite in 512-Byte-Blöcken fest."

msgid "Same as uquota."
msgstr "Entspricht uquota."

msgid "Runs filesystem namespace operations synchronously."
msgstr "Führt Namespace-Operationen des Dateisystems synchron aus."

msgid "Enables POSIX access control lists (default on)."
msgstr "Aktiviert POSIX-Zugriffssteuerungslisten (standardmäßig an)."

msgid "Auto-defragments detected small random writes."
msgstr "Defragmentiert erkannte kleine zufällige Schreibvorgänge automatisch."

msgid "Disables automatic file defragmentation."
msgstr "Deaktiviert die automatische Defragmentierung von Dateien."

msgid "Ensures writes flush to permanent storage at checkpoints."
msgstr "Stellt sicher, dass Schreibvorgänge an Checkpoints dauerhaft geschrieben werden."

msgid "Disables write barriers; risks corruption on crash."
msgstr "Deaktiviert Schreibbarrieren; Korruptionsrisiko bei Absturz."

msgid "Clears and rebuilds the free space cache."
msgstr "Leert und baut den Freiraum-Cache neu auf."

msgid "Sets transaction commit interval in seconds (default 30)."
msgstr "Legt das Commit-Intervall für Transaktionen in Sekunden fest (Standard: 30)."

msgid "Enables data compression, optionally with a level (for example zstd:3)."
msgstr "Aktiviert Datenkomprimierung, optional mit Stufe (z. B. zstd:3)."

msgid "Always attempts compression, even if ineffective, optionally with a level."
msgstr "Versucht immer zu komprimieren, auch wenn es wirkungslos ist, optional mit Stufe."

msgid "Enables data copy-on-write for new files."
msgstr "Aktiviert Copy-on-Write für die Daten neuer Dateien."

msgid "Disables data COW (implies nodatasum, no compression)."
msgstr "Deaktiviert Daten-COW (impliziert nodatasum, keine Kompression)."

msgid "Enables data checksumming."
msgstr "Aktiviert die Prüfsummenbildung für Daten."

msgid "Disables data checksumming."
msgstr "Deaktiviert die Prüfsummenbildung für Daten."

msgid "Allows mount with fewer devices than RAID requires."
msgstr "Ermöglicht das Einhängen mit weniger Geräten, als RAID erfordert."

msgid "Scans the given device for btrfs during mount."
msgstr "Durchsucht das angegebene Gerät beim Einhängen nach btrfs."

msgid "Discards freed file blocks (TRIM)."
msgstr "Verwirft freigegebene Dateiblöcke (TRIM)."

msgid "Disables discarding of freed blocks."
msgstr "Deaktiviert das Verwerfen freigegebener Blöcke."

msgid "Enables verbose output for ENOSPC conditions."
msgstr "Aktiviert ausführliche Ausgabe bei ENOSPC-Zuständen."

msgid "Disables verbose ENOSPC output."
msgstr "Deaktiviert die ausführliche ENOSPC-Ausgabe."

msgid "Sets action on fatal errors: bug or panic."
msgstr "Legt die Aktion bei fatalen Fehlern fest: bug oder panic."

msgid "Flushes all prior-transaction data at each commit."
msgstr "Schreibt bei jedem Commit alle Daten vorheriger Transaktionen aus."

msgid "Disables forced full flush on commit."
msgstr "Deaktiviert das erzwungene vollständige Ausleeren beim Commit."

msgid "Intentionally fragments block groups (debug builds only)."
msgstr "Fragmentiert Blockgruppen absichtlich (nur für Debug-Builds)."

msgid "Max bytes that can be inlined in a metadata leaf."
msgstr "Max. Bytes, die in einem Metadaten-Leaf inline abgelegt werden können."

msgid "Allocates one metadata chunk per N data chunks."
msgstr "Alloziert einen Metadaten-Chunk pro N Daten-Chunks."

msgid "Does not replay the tree log (same as norecovery)."
msgstr "Spielt das Baumprotokoll nicht ab (entspricht norecovery)."

msgid "Does not attempt recovery at mount time."
msgstr "Versucht beim Einhängen keine Wiederherstellung."

msgid "Forces rebuild of the UUID tree."
msgstr "Erzwingt den Neuaufbau des UUID-Baums."

msgid "Applies recovery workarounds: usebackuproot, nologreplay, ignorebadroots, ignore*sums, or all (read-only)."
msgstr "Wendet Wiederherstellungs-Umgehungen an: usebackuproot, nologreplay, ignorebadroots, ignore*sums oder all (nur lesend)."

msgid "Skips automatic resume of an interrupted balance."
msgstr "Überspringt die automatische Fortsetzung einer unterbrochenen Balance."

msgid "Enables free space caching (v1 or v2)."
msgstr "Aktiviert den Freiplatz-Cache (v1 oder v2)."

msgid "Disables the free space cache."
msgstr "Deaktiviert den Freiplatz-Cache."

msgid "Enables SSD allocation optimizations."
msgstr "Aktiviert Allokations-Optimierungen für SSDs."

msgid "Disables SSD allocation optimizations."
msgstr "Deaktiviert Allokations-Optimierungen für SSDs."

msgid "Allocates into larger aligned chunks for low-end SSDs."
msgstr "Alloziert für Low-End-SSDs in größere, ausgerichtete Chunks."

msgid "Disables the ssd_spread allocation scheme."
msgstr "Deaktiviert das ssd_spread-Allokationsschema."

msgid "Mounts a subvolume at the given path, not the toplevel."
msgstr "Hängt ein Subvolume am angegebenen Pfad ein, nicht das Toplevel."

msgid "Mounts the subvolume with the given numeric ID."
msgstr "Hängt das Subvolume mit der angegebenen numerischen ID ein."

msgid "Sets number of worker threads."
msgstr "Legt die Anzahl der Arbeits-Threads fest."

msgid "Enables tree logging for fsync/O_SYNC."
msgstr "Aktiviert die Baum-Protokollierung für fsync/O_SYNC."

msgid "Disables tree logging."
msgstr "Deaktiviert die Baum-Protokollierung."

msgid "Tries backup roots if the tree root is bad; removed since 7.3."
msgstr "Versucht, Backup-Wurzeln zu verwenden, wenn die Baumwurzel defekt ist; seit 7.3 entfernt."

msgid "Lets subvolume owners delete their own subvolumes."
msgstr "Erlaubt Subvolume-Eigentümern, ihre eigenen Subvolumes zu löschen."

msgid "Sets number of active log segments (2, 4, or 6)."
msgstr "Legt die Anzahl der aktiven Log-Segmente fest (2, 4 oder 6)."

msgid "Enables age extent cache for allocation hints."
msgstr "Aktiviert den Age-Extent-Cache für Allokationshinweise."

msgid "Sets block allocation policy: reuse or default."
msgstr "Legt die Block-Allokationsrichtlinie fest: reuse oder default."

msgid "Enables age-threshold background garbage collection."
msgstr "Aktiviert die automatische Hintergrundbereinigung anhand einer Altersgrenze."

msgid "Turns background garbage collection on/off/sync."
msgstr "Schaltet die automatische Hintergrundbereinigung ein/aus/sync."

msgid "Allows cache_flush commands to be issued."
msgstr "Erlaubt das Senden von cache_flush-Befehlen."

msgid "Skips cache_flush commands if storage guarantees order."
msgstr "Überspringt cache_flush-Befehle, wenn der Speicher die Reihenfolge garantiert."

msgid "Enables or disables checkpointing (disable/enable)."
msgstr "Aktiviert oder deaktiviert Checkpointing (disable/enable)."

msgid "Merges concurrent checkpoint requests via a daemon."
msgstr "Bündelt gleichzeitige Checkpoint-Anfragen über einen Daemon."

msgid "Disables checkpoint merge feature."
msgstr "Deaktiviert die Checkpoint-Merge-Funktion."

msgid "Selects compression algorithm (lzo, lz4, zstd)."
msgstr "Wählt den Kompressionsalgorithmus (lzo, lz4, zstd)."

msgid "Caches compressed blocks to improve read hit ratio."
msgstr "Cacht komprimierte Blöcke, um die Lese-Trefferquote zu verbessern."

msgid "Verifies checksums of compressed clusters."
msgstr "Prüft die Prüfsummen von komprimierten Clustern."

msgid "Adds extensions whose files are auto-compressed."
msgstr "Fügt Erweiterungen hinzu, deren Dateien automatisch komprimiert werden."

msgid "Sets compress cluster size in 4KB units."
msgstr "Legt die Kompressions-Cluster-Größe in 4-KB-Einheiten fest."

msgid "Sets compression mode: fs (auto) or user (manual)."
msgstr "Setzt den Kompressionsmodus: fs (automatisch) oder user (manuell)."

msgid "Flushes data before checkpoint to persist regular files."
msgstr "Schreibt Daten vor dem Checkpoint fest, um reguläre Dateien zu sichern."

msgid "Ignores mkfs extension list for cold-file detection."
msgstr "Ignoriert die Liste der mkfs-Dateiendungen für die Erkennung kalter Dateien."

msgid "Disables the roll-forward recovery routine."
msgstr "Deaktiviert die Roll-Forward-Wiederherstellungsroutine."

msgid "Enables real-time discard/TRIM commands."
msgstr "Aktiviert Echtzeit-Discard/TRIM-Befehle."

msgid "Disables real-time discard."
msgstr "Deaktiviert Echtzeit-Discard."

msgid "Sets discard alignment unit: block, segment, or section."
msgstr "Setzt die Discard-Ausrichtungseinheit: block, segment oder section."

msgid "Sets behavior on critical errors: panic, continue, remount-ro."
msgstr "Setzt das Verhalten bei kritischen Fehlern: panic, continue oder remount-ro."

msgid "Enables the rb-tree extent cache (default)."
msgstr "Aktiviert den rb-tree-Extent-Cache (Standard)."

msgid "Disables the extent cache."
msgstr "Deaktiviert den Extent-Cache."

msgid "Reduces mount time at the cost of normal performance."
msgstr "Verkürzt die Einhängezeit auf Kosten der normalen Leistung."

msgid "Enables fault injection at a given rate (testing)."
msgstr "Aktiviert Fehlerinjektion mit einer bestimmten Rate (Test)."

msgid "Configures which fault types to inject (testing)."
msgstr "Konfiguriert, welche Fehlertypen injiziert werden (Test)."

msgid "Merges concurrent cache_flush commands."
msgstr "Führt gleichzeitige cache_flush-Befehle zusammen."

msgid "Sets fsync policy: posix, strict, or nobarrier."
msgstr "Setzt die fsync-Richtlinie: posix, strict oder nobarrier."

msgid "Handles foreground GC in the background GC thread."
msgstr "Verarbeitet Foreground-GC im Hintergrund-GC-Thread."

msgid "Disables GC merge feature."
msgstr "Deaktiviert die GC-Merge-Funktion."

msgid "Points to group journaled quota file."
msgstr "Verweist auf die journalisierte Gruppenquotadatei."

msgid "Enables group disk quota accounting."
msgstr "Aktiviert die Datenträgerquota-Abrechnung für Gruppen."

msgid "Allocates segments heap-based from disk end; deprecated."
msgstr "Allokiert Segmente haufbasiert ab dem Datenträgerende; veraltet."

msgid "Disables heap-based allocation; deprecated."
msgstr "Deaktiviert die haufbasierte Allokation; veraltet."

msgid "Stores small file data inside the inode block."
msgstr "Speichert Daten kleiner Dateien im Inode-Block."

msgid "Stores directory entries inside the inode block."
msgstr "Speichert Verzeichniseinträge im Inode-Block."

msgid "Disables the inline dentry feature."
msgstr "Deaktiviert die Inline-dentry-Funktion."

msgid "Enables inline extended attributes."
msgstr "Aktiviert erweiterte Attribute inline."

msgid "Disables inline extended attributes."
msgstr "Deaktiviert erweiterte Attribute inline."

msgid "Sets the inline xattr size."
msgstr "Setzt die Größe der Inline-Xattrs."

msgid "Uses blk-crypto for inline encryption hardware."
msgstr "Verwendet blk-crypto für Inline-Verschlüsselungshardware."

msgid "Sets casefold directory lookup: perf, compat, or auto."
msgstr "Setzt die Casefold-Verzeichnisauflösung: perf, compat oder auto."

msgid "Sets memory mode: normal or low."
msgstr "Setzt den Speichermodus: normal oder low."

msgid "Sets block allocation mode: adaptive or lfs."
msgstr "Setzt den Blockallokationsmodus: adaptive oder lfs."

msgid "Enables faster full/empty NAT block access."
msgstr "Aktiviert schnelleren Zugriff auf volle/leere NAT-Blöcke."

msgid "Disables the inline data feature."
msgstr "Deaktiviert die Inline-Daten-Funktion."

msgid "Disables roll-forward recovery and mounts read-only."
msgstr "Deaktiviert Roll-Forward-Wiederherstellung und bindet schreibgeschützt ein."

msgid "Disables user extended attributes."
msgstr "Deaktiviert erweiterte Benutzerattribute."

msgid "Disables all plain disk quota options."
msgstr "Deaktiviert alle Optionen der einfachen Datenträgerquota."

msgid "Points to project journaled quota file."
msgstr "Verweist auf die journalisierte Projektquotadatei."

msgid "Enables project quota accounting."
msgstr "Aktiviert die Quota-Abrechnung für Projekte."

msgid "Enables plain user disk quota accounting."
msgstr "Aktiviert die einfache Benutzer-Datenträgerquota-Abrechnung."

msgid "Sets reserved nodes for privileged-user allocation."
msgstr "Setzt reservierte Nodes für die Allokation privilegierter Benutzer."

msgid "Sets reserved space (%) for privileged-user allocation."
msgstr "Setzt den reservierten Speicherplatz (%) für Allokation privilegierter Benutzer."

msgid "Group ID with access to reserved blocks and nodes."
msgstr "Gruppen-ID mit Zugriff auf reservierte Blöcke und Nodes."

msgid "User ID with access to reserved blocks and nodes."
msgstr "Benutzer-ID mit Zugriff auf reservierte Blöcke und Nodes."

msgid "Enables dummy fscrypt context for testing."
msgstr "Aktiviert einen Dummy-fscrypt-Kontext für Tests."

msgid "Points to user journaled quota file."
msgstr "Verweist auf die journalisierte Benutzerquotadatei."

msgid "Enables user disk quota accounting."
msgstr "Aktiviert die Benutzer-Datenträgerquota-Abrechnung."

msgid "Enables POSIX Access Control List support."
msgstr "Aktiviert die Unterstützung für POSIX-Zugriffskontrolllisten."

msgid "Enables TRIM support for SSD delete performance."
msgstr "Aktiviert TRIM-Unterstützung für die Löschleistung von SSDs."

msgid "Permission mask for directories."
msgstr "Berechtigungsmaske für Verzeichnisse."

msgid "Permission mask for files."
msgstr "Berechtigungsmaske für Dateien."

msgid "Forces mounting even if the volume is dirty (not recommended)."
msgstr "Erzwingt das Einhängen, auch wenn das Laufwerk schmutzig ist (nicht empfohlen)."

msgid "Default group ID for created files and directories."
msgstr "Standard-Gruppenkennung für erstellte Dateien und Verzeichnisse."

msgid "Sets the HIDDEN attribute for names starting with a dot."
msgstr "Setzt das Attribut HIDDEN für Namen, die mit einem Punkt beginnen."

msgid "Charset used to translate path strings to Unicode."
msgstr "Zeichensatz zur Umwandlung von Pfadzeichenketten in Unicode."

msgid "Hides files with the Windows HIDDEN attribute."
msgstr "Blendet Dateien mit dem Windows-Attribut HIDDEN aus."

msgid "Preallocates space to reduce write fragmentation."
msgstr "Reserviert Speicher vorab, um Schreibfragmentierung zu reduzieren."

msgid "Shows all NTFS meta-files (system files)."
msgstr "Zeigt alle NTFS-Metadateien (Systemdateien) an."

msgid "Creates new files as sparse."
msgstr "Erstellt neue Dateien als Sparse-Dateien."

msgid "Marks files with the SYSTEM attribute as immutable."
msgstr "Markiert Dateien mit dem Attribut SYSTEM als unveränderlich."

msgid "Default user ID for created files and directories."
msgstr "Standard-Benutzerkennung für erstellte Dateien und Verzeichnisse."

msgid "Default permission mask for files and directories."
msgstr "Standard-Berechtigungsmaske für Dateien und Verzeichnisse."

msgid "Rejects filenames not allowed by Windows."
msgstr "Verwirft Dateinamen, die von Windows nicht zulässig sind."

msgid "Relaxes utime() permission checks for changing timestamps."
msgstr "Lockert die utime()-Berechtigungsprüfungen für die Änderung von Zeitstempeln."

msgid "Sets the block size; obsolete."
msgstr "Setzt die Blockgröße; veraltet."

msgid "Sets case-sensitivity checking (strict, relaxed, or normal)."
msgstr "Setzt die Groß-/Kleinschreibungsprüfung (strict, relaxed oder normal)."

msgid "Sets codepage for converting to shortname characters."
msgstr "Setzt die Codepage für die Umwandlung in Kurznamenzeichen."

msgid "Obsolete; may fail or be ignored."
msgstr "Veraltet; kann fehlschlagen oder ignoriert werden."

msgid "Obsolete; forces use of a CVF compressed-volume module."
msgstr "Veraltet; erzwingt die Verwendung eines CVF-Moduls für komprimierte Volumes."

msgid "Obsolete; passes an option to the CVF module."
msgstr "Veraltet; leitet eine Option an das CVF-Modul weiter."

msgid "Enables debug output; unused by current implementation."
msgstr "Aktiviert Debugausgabe; wird von der aktuellen Implementierung nicht verwendet."

msgid "Uses DOS 1.x BIOS Parameter Block defaults for small floppies."
msgstr "Verwendet die BIOS-Parameter-Block-Standardwerte von DOS 1.x für kleine Disketten."

msgid "Forces DOS dot conventions on filenames (obsolete)."
msgstr "Erzwingt DOS-Punktkonventionen für Dateinamen (veraltet)."

msgid "Forces Unix-style names without DOS dots (obsolete)."
msgstr "Erzwingt Unix-artige Namen ohne DOS-Punkte (veraltet)."

msgid "Allows dots in 8.3 short names (obsolete)."
msgstr "Erlaubt Punkte in 8.3-Kurznamen (veraltet)."

msgid "Sets FAT behavior on errors: panic, continue, or remount-ro."
msgstr "Setzt das FAT-Verhalten bei Fehlern: panic, continue oder remount-ro."

msgid "Forces FAT type 12, 16, or 32, overriding auto-detection."
msgstr "Erzwingt den FAT-Typ 12, 16 oder 32 und überschreibt die automatische Erkennung."

msgid "Flushes data to disk earlier than normal."
msgstr "Schreibt Daten früher als üblich auf die Platte."

msgid "Permission mask for regular files."
msgstr "Berechtigungsmaske für reguläre Dateien."

msgid "Group ID applied to all files."
msgstr "Gruppenkennung für alle Dateien."

msgid "Charset converting filenames between disk and Unicode."
msgstr "Zeichensatz zur Umwandlung von Dateinamen zwischen Datenträger und Unicode."

msgid "Enables NFS export support (stale_rw or nostale_ro)."
msgstr "Aktiviert die NFS-Exportunterstützung (stale_rw oder nostale_ro)."

msgid "Deprecated; use shortname=win95 instead."
msgstr "Abgelöst; verwenden Sie stattdessen shortname=win95."

msgid "Skips the ~number tail in 8.3 aliases when possible."
msgstr "Überspringt die ~Zahl-Endung in 8.3-Aliassen, wenn möglich."

msgid "Obsolete; allowed files differing only in case."
msgstr "Veraltet; erlaubte Dateien, die sich nur durch Groß-/Kleinschreibung unterschieden."

msgid "Suppresses warning messages and chmod/chown errors."
msgstr "Unterdrückt Warnmeldungen und chmod/chown-Fehler."

msgid "Treats the FAT read-only attribute as read-only for directories."
msgstr "Behandelt das FAT-Attribut „schreibgeschützt\" für Verzeichnisse als schreibgeschützt."

msgid "Sets 8.3 short-name display/create mode (lower, win95, winnt, mixed)."
msgstr "Setzt den Anzeige-/Erstellmodus für 8.3-Kurznamen (lower, win95, winnt, mixed)."

msgid "Allows execute permission only for .EXE, .COM, or .BAT files."
msgstr "Erlaubt die Ausführberechtigung nur für .EXE-, .COM- oder .BAT-Dateien."

msgid "Treats the FAT system attribute as the immutable flag."
msgstr "Behandelt das FAT-Systemattribut als Unveränderlichkeitsflag."

msgid "Sets minute offset converting FAT local time to UTC."
msgstr "Setzt die Minutenverschiebung zur Umwandlung der lokalen FAT-Zeit in UTC."

msgid "Interprets timestamps as UTC instead of local time."
msgstr "Interpretiert Zeitstempel als UTC statt als lokale Zeit."

msgid "Owner user ID applied to all files."
msgstr "Besitzer-Benutzerkennung für alle Dateien."

msgid "Permission mask for files and directories."
msgstr "Berechtigungsmaske für Dateien und Verzeichnisse."

msgid "Escapes unhandled Unicode characters as :XXXX sequences."
msgstr "Maskiert nicht verarbeitete Unicode-Zeichen als :XXXX-Sequenzen."

msgid "Uses the free-cluster count stored in FSINFO."
msgstr "Verwendet die in FSINFO gespeicherte Anzahl freier Cluster."

msgid "Use UTF-8 to encode long file names."
msgstr "Verwendet UTF-8 zur Kodierung langer Dateinamen."

msgid "Deprecated; accepted but has no effect."
msgstr "Abgelöst; wird akzeptiert, hat aber keine Wirkung."

msgid "Sets behavior on errors: panic, continue, or remount-ro."
msgstr "Setzt das Verhalten bei Fehlern: panic, continue oder remount-ro."

msgid "Default group ID applied to all files."
msgstr "Standard-Gruppenkennung für alle Dateien."

msgid "Keeps trailing periods in path components and filenames."
msgstr "Behält abschließende Punkte in Pfadkomponenten und Dateinamen bei."

msgid "Uses the system timezone for timestamps lacking a valid offset."
msgstr "Verwendet die Systemzeitzone für Zeitstempel ohne gültiges Offset."

msgid "Sets minute offset converting timestamps to UTC."
msgstr "Setzt die Minutenverschiebung zur Umrechnung von Zeitstempeln in UTC."

msgid "Default user ID applied to all files."
msgstr "Standard-Benutzerkennung für alle Dateien."

msgid "Creates directories with zero size, allocating no cluster."
msgstr "Erstellt Verzeichnisse mit Nullgröße und ordnet kein Cluster zu."

msgid "Enables swap discard; supports discard=once or discard=pages."
msgstr "Aktiviert Swap-Discard; unterstützt discard=once oder discard=pages."

msgid "Sets the swap device priority (0-32767)."
msgstr "Setzt die Priorität des Swap-Geräts (0-32767)."

msgid "Maximum seconds to cache directory attributes."
msgstr "Maximale Sekunden zum Zwischenspeichern von Verzeichnisattributen."

msgid "Maximum seconds to cache regular file attributes."
msgstr "Maximale Sekunden zum Zwischenspeichern von Attributen normaler Dateien."

msgid "Seconds to cache file/directory attributes before re-checking."
msgstr "Sekunden zum Zwischenspeichern von Datei-/Verzeichnisattributen vor der erneuten Prüfung."

msgid "Sets the destination IP address of the server."
msgstr "Setzt die Ziel-IP-Adresse des Servers."

msgid "Members of this group open files with backup intent."
msgstr "Mitglieder dieser Gruppe öffnen Dateien im Backup-Modus."

msgid "This user opens files with backup intent."
msgstr "Dieser Benutzer öffnet Dateien im Backup-Modus."

msgid "Overrides the default block size reported on SMB3 files."
msgstr "Überschreibt die standardmäßig bei SMB3-Dateien gemeldete Blockgröße."

msgid "Cache mode for file data: none, strict or loose."
msgstr "Zwischenspeichermodus für Dateidaten: none, strict oder loose."

msgid "Maps CIFS/NTFS ACLs and SIDs to/from Linux permissions."
msgstr "Mappt CIFS/NTFS-ACLs und SIDs in Linux-Berechtigungen und umgekehrt."

msgid "Max seconds to defer the final SMB3 file close."
msgstr "Maximale Sekunden bis zur endgültigen Schließung von SMB3-Dateien."

msgid "Enables experimental SMB 3.1.1 message compression."
msgstr "Aktiviert die experimentelle Nachrichtenkompression für SMB 3.1.1."

msgid "Reads username/password from a credentials file."
msgstr "Liest Benutzername/Passwort aus einer Anmeldedaten-Datei."

msgid "Uid owning the credentials cache (useful with krb5)."
msgstr "UID, die den Anmeldedaten-Cache besitzt (nützlich bei krb5)."

msgid "Overrides the default mode for directories."
msgstr "Überschreibt den Standardmodus für Verzeichnisse."

msgid "Sets the user's domain (workgroup)."
msgstr "Setzt die Domain (Arbeitsgruppe) des Benutzers."

msgid "Auto-guesses the server domain from the NTLM challenge."
msgstr "Ermittelt die Serverdomain automatisch aus der NTLM-Challenge."

msgid "Keeps unsupported permissions in memory only; unreliable."
msgstr "Behält nicht unterstützte Berechtigungen nur im Speicher; unzuverlässig."

msgid "Seconds between keepalive echo requests."
msgstr "Sekunden zwischen Keepalive-Echo-Anfragen."

msgid "Min encrypted-read size before offloading decryption."
msgstr "Min. Größe verschlüsselter Lesezugriffe vor dem Auslagern der Entschlüsselung."

msgid "Overrides the default mode for regular files."
msgstr "Überschreibt den Standardmodus für normale Dateien."

msgid "Ignores server gid and always uses the gid value."
msgstr "Ignoriert die GID des Servers und verwendet immer den gid-Wert."

msgid "Ignores server uid and always uses the uid value."
msgstr "Ignoriert die UID des Servers und verwendet immer den uid-Wert."

msgid "Always uses CIFS-style mandatory locks."
msgstr "Verwendet immer CIFS-artige Pflichtsperrungen."

msgid "Enables local disk caching via FS-Cache."
msgstr "Aktiviert lokales Festplattencaching über FS-Cache."

msgid "Default gid owning files when the server gives none."
msgstr "Standard-GID für Dateien, wenn der Server keine angibt."

msgid "Don't prompt for a password; mount as guest."
msgstr "Keine Passwortabfrage; als Gast einhängen."

msgid "Keeps the share root directory handle cached."
msgstr "Hält den Handle des Hauptverzeichnisses der Freigabe im Cache."

msgid "Ms the server reserves handles after failover."
msgstr "Millisekunden, die der Server nach Failover für Handles reserviert."

msgid "Hangs when the server crashes instead of erroring."
msgstr "Hängt bei einem Serverabsturz fest, statt einen Fehler zu melden."

msgid "Extracts uid/gid from a special SID instead of mapping."
msgstr "Extrahiert uid/gid aus einer speziellen SID, anstatt sie zu mappen."

msgid "Synonym for nocase; case-insensitive matching."
msgstr "Synonym für nocase; case-insensitive Abgleich."

msgid "Allow interrupts while hung; currently unimplemented."
msgstr "Unterbrechungen während des Hängens erlauben; derzeit nicht implementiert."

msgid "Charset for converting path names to/from Unicode."
msgstr "Zeichensatz für die Umwandlung von Pfadnamen in und aus Unicode."

msgid "Enables Unix Extensions (synonym for posix/unix)."
msgstr "Aktiviert Unix-Erweiterungen (Synonym für posix/unix)."

msgid "Checks cached leases locally instead of querying server."
msgstr "Prüft zwischengespeicherte Leases lokal, ohne den Server abzufragen."

msgid "Translates reserved Windows filename characters."
msgstr "Übersetzt reservierte Windows-Dateinamenzeichen."

msgid "Maps reserved characters per Microsoft Services For Mac."
msgstr "Mappt reservierte Zeichen gemäß Microsoft Services For Mac."

msgid "Maximum number of cached directories per share."
msgstr "Maximale Anzahl zwischengespeicherter Verzeichnisse pro Freigabe."

msgid "Number of multichannel transport connections (max 16)."
msgstr "Anzahl der Multichannel-Transportverbindungen (max. 16)."

msgid "Maximum SMB2 credits the client can hold."
msgstr "Maximale SMB2-Credits, die der Client halten kann."

