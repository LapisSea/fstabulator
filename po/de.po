msgstr "RPC-Version zur Kontaktaufnahme mit mountd."

msgid "Maximum length of a pathname component."
msgstr "Maximale Länge eines Pfadbestandteils."

msgid "Number of connections to establish to the server."
msgstr "Anzahl der zum Server aufzubauenen Verbindungen."

msgid "NFS protocol version (synonym of vers)."
msgstr "NFS-Protokollversion (Synonym für vers)."

msgid "Disables rounding buffered writes to page boundaries."
msgstr "Deaktiviert das Ausrichten gepuffter Schreibvorgänge auf Seitengrenzen."

msgid "Disables READDIRPLUS requests."
msgstr "Deaktiviert READDIRPLUS-Anfragen."

msgid "Port of the server's NFS service."
msgstr "Port des NFS-Dienstes des Servers."

msgid "Transport protocol: udp, tcp or rdma."
msgstr "Transportprotokoll: udp, tcp oder rdma."

msgid "Uses RDMA transport (synonym for proto=rdma)."
msgstr "Verwendet RDMA-Transport (Synonym für proto=rdma)."

msgid "Enables READDIRPLUS requests."
msgstr "Aktiviert READDIRPLUS-Anfragen."

