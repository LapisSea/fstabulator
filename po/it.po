msgstr "Dispositivo/etichetta preferita per le scritture in foreground."

msgid "Runs fsck during mount."
msgstr "Esegue fsck durante il montaggio."

msgid "Enables inline data extents for small files (default on)."
msgstr "Abilita gli extent di dati inline per i file di piccole dimensioni (predefinito on)."

msgid "Restricts new inode numbers to 32 bits."
msgstr "Limita i nuovi numeri di inode a 32 bit."

msgid "Milliseconds before an automatic journal commit (default 1000)."
msgstr "Millisecondi prima del commit automatico del journal (valore predefinito 1000)."

msgid "Disables journal flush on sync/fsync."
msgstr "Disabilita il flush del journal su sync/fsync."

msgid "Milliseconds before automatic journal reclaim."
msgstr "Millisecondi prima del reclaim automatico del journal."

msgid "Checksum type used for metadata writes."
msgstr "Tipo di checksum usato per le scritture dei metadati."

msgid "Number of replicas to keep for metadata (journal and btree)."
msgstr "Numero di repliche da conservare per i metadati (journal e btree)."

