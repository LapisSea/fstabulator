msgid "Cannot mount"
msgstr "Montiranje nije moguće"

msgid "A password is required."
msgstr "Potrebna je lozinka."

msgid "A credentials file name is required when saving credentials."
msgstr "Naziv datoteke s vjerodajnicama potreban je pri spremanju vjerodajnica."

msgid "Could not mount"
msgstr "Nije moguće montirati"

msgid "Credentials deleted"
msgstr "Vjerodajnice su izbrisane"

msgid "The saved credentials file was deleted."
msgstr "Spremljena datoteka s vjerodajnicama je izbrisana."

msgid "Could not delete credentials"
msgstr "Nije moguće izbrisati vjerodajnice"

msgid "Delete credentials"
msgstr "Izbriši vjerodajnice"

msgid "login used for this mount only"
msgstr "prijava koja se koristi samo za ovo montiranje"

#. xgettext: keep the <b> markup tags intact
msgid "linked login to entry, <b>you must save changes to preserve this</b>"
msgstr "prijava je povezana s unosom, <b>morate spremiti promjene da biste to sačuvali</b>"

msgid "Mounted"
msgstr "Montirano"

msgid "Username"
msgstr "Korisničko ime"

msgid "Password"
msgstr "Lozinka"

msgid "Domain (optional)"
msgstr "Domena (neobavezno)"

msgid "Save for auto-mount"
msgstr "Spremi za automatsko povezivanje"

msgid "Writes a credentials file referenced from the fstab entry."
msgstr "Stvara datoteku s vjerodajnicama na koju upućuje unos u fstab-u."

msgid "Credentials file"
msgstr "Datoteka s vjerodajnicama"

msgid "Load existing credentials"
msgstr "Učitaj postojeće vjerodajnice"

msgid "Will overwrite the existing file!"
msgstr "Prebrisat će postojeću datoteku!"

msgid "This filesystem may require credentials to mount."
msgstr "Za montiranje ovog datotečnog sustava mogu biti potrebne vjerodajnice."

msgid "Cancel"
msgstr "Odustani"

msgid "Connect"
msgstr "Poveži se"

msgid "User"
msgstr "Korisnik"

msgid "Host"
msgstr "Poslužitelj"

msgid "Port"
msgstr "Port"

msgid "Path"
msgstr "Putanja"

msgid "Test connection"
msgstr "Testiraj vezu"

msgid "Network location"
msgstr "Mrežna lokacija"

msgid "Save"
msgstr "Spremi"

msgid "Enter a valid port to test."
msgstr "Unesite ispravan priključak za testiranje."

msgid "Enter a host to test."
msgstr "Unesite poslužitelj za testiranje."

msgid "Testing connection…"
msgstr "Testiranje veze…"

msgid "Test connection failed."
msgstr "Testiranje veze nije uspjelo."

msgid "Enter a host to save."
msgstr "Unesite poslužitelj za spremanje."

msgid "Could not list devices"
msgstr "Nije moguće prikazati popis uređaja"

msgid "Filter devices…"
msgstr "Filtriraj uređaje…"

msgid "No devices found"
msgstr "Nije pronađen nijedan uređaj"

msgid "Device name"
msgstr "Naziv uređaja"

msgid "Size"
msgstr "Veličina"

msgid "Label"
msgstr "Oznaka"

msgid "File System"
msgstr "Datotečni sustav"

msgid "Model"
msgstr "Model"

msgid "Edit device"
msgstr "Uredi uređaj"

msgid "All I/O to the filesystem is done asynchronously."
msgstr "Sve U/I operacije na datotečnom sustavu izvode se asinkrono."

msgid "Update inode access time on every access."
msgstr "Ažurira vrijeme pristupa inodea pri svakom pristupu."

msgid "Can be mounted with the -a (mount all) option."
msgstr "Može se montirati opcijom -a (montiraj sve)."

msgid "Remount a subtree elsewhere; mount only that subtree."
msgstr "Ponovno montira podstablo na drugo mjesto; montira samo to podstablo."

msgid "Comment field; ignored by the mount command."
msgstr "Polje za komentar; mount naredba ga zanemaruje."

msgid "Set the SELinux context for the whole filesystem."
msgstr "Postavlja SELinux kontekst za cijeli datotečni sustav."

msgid "Use default options: rw, suid, dev, exec, auto, nouser, async."
msgstr "Koristi zadane opcije: rw, suid, dev, exec, auto, nouser, async."

msgid "Set the default SELinux context for unlabeled files."
msgstr "Postavlja zadani SELinux kontekst za neoznačene datoteke."

msgid "Interpret character or block special devices on the filesystem."
msgstr "Omogućuje korištenje znakovnih i blokovskih uređaja na datotečnom sustavu."

msgid "Update directory access times on reads."
msgstr "Ažurira vremena pristupa direktorija pri čitanju."

msgid "Make all directory updates synchronous."
msgstr "Čini sva ažuriranja direktorija sinkronima."

msgid "Permit execution of binaries on the filesystem."
msgstr "Dopušta izvršavanje binarnih datoteka na datotečnom sustavu."

msgid "Set the SELinux context for the filesystem being mounted."
msgstr "Postavlja SELinux kontekst za datotečni sustav koji se montira."

msgid "Allow mounting by a user whose group matches the device's group."
msgstr "Dopušta montiranje korisniku čija se grupa podudara s grupom uređaja."

msgid "Increment the inode version on every inode modification."
msgstr "Povećava verziju inodea pri svakoj izmjeni inodea."

msgid "Update on-disk timestamps lazily, flushing them later."
msgstr "Lijeno ažurira vremenske oznake na disku i ispira ih kasnije."

msgid "Mount the file through a loop device."
msgstr "Montira datoteku putem loop uređaja."

msgid "Turn off the silent flag (verbose errors)."
msgstr "Isključuje tihi način rada (prikazuje detaljne poruke o pogreškama)."

msgid "Allow mandatory locking on the filesystem."
msgstr "Dopušta obvezno zaključavanje na datotečnom sustavu."

msgid "Atomically move a mounted tree to a new location."
msgstr "Atomski premješta montirano stablo na novu lokaciju."

msgid "Do not update inode access times on reads."
msgstr "Ne ažurira vremena pristupa inodea pri čitanju."

msgid "Can only be mounted explicitly, never with -a."
msgstr "Može se montirati samo eksplicitno, nikada s opcijom -a."

msgid "Do not interpret character or block special devices."
msgstr "Ne tumači znakovne ili blokovske posebne uređaje."

msgid "Do not update directory access times."
msgstr "Ne ažurira vremena pristupa direktorija."

msgid "Do not permit execution of binaries on the filesystem."
msgstr "Ne dopušta izvršavanje binarnih datoteka na datotečnom sustavu."

msgid "Do not report errors if the device does not exist."
msgstr "Ne javlja pogrešku ako uređaj ne postoji."

msgid "Do not increment the inode version counter."
msgstr "Ne povećava brojač verzija inodea."

msgid "Do not use the lazytime feature; flush timestamps at once."
msgstr "Ne koristi značajku lazytime; odmah ispire vremenske oznake."

msgid "Do not allow mandatory locking on the filesystem."
msgstr "Ne dopušta obvezno zaključavanje na datotečnom sustavu."

msgid "Do not use the relatime feature."
msgstr "Ne koristi značajku relatime."

msgid "Do not honor setuid or setgid bits or file capabilities."
msgstr "Ne poštuje setuid/setgid bitove ni mogućnosti datoteka."

msgid "Do not follow symbolic links when resolving paths."
msgstr "Ne slijedi simboličke veze pri rješavanju putanja."

msgid "Use the kernel's default access-time behavior."
msgstr "Koristi zadano ponašanje kernela za vremena pristupa."

msgid "Only root may mount the filesystem."
msgstr "Samo root smije montirati datotečni sustav."

msgid "Mount only after the network is available."
msgstr "Montira tek nakon što mreža postane dostupna."

msgid "Allow mounting by the owner of the device."
msgstr "Dopušta montiranje vlasniku uređaja."

msgid "Make the mount private (no propagation to other mounts)."
msgstr "Čini montiranje privatnim (bez propagacije na druga montiranja)."

msgid "Remount a subtree and all its submounts elsewhere."
msgstr "Ponovno montira podstablo i sva njegova podmontiranja na drugo mjesto."

msgid "Update access times relative to modify or change time."
msgstr "Ažurira vremena pristupa relativno prema vremenu izmjene ili promjene."

msgid "Attempt to remount an already-mounted filesystem."
msgstr "Pokušava ponovno montirati već montirani datotečni sustav."

msgid "Mount the filesystem read-only."
msgstr "Montira datotečni sustav samo za čitanje."

msgid "Set the SELinux context of the filesystem's root inode."
msgstr "Postavlja SELinux kontekst korijenskog inodea datotečnog sustava."

msgid "Make the mount and its submounts private."
msgstr "Čini montiranje i njegova podmontiranja privatnima."

msgid "Make the mount and its submounts shared."
msgstr "Čini montiranje i njegova podmontiranja dijeljenima."

msgid "Make the mount and its submounts slaves of their master."
msgstr "Čini montiranje i njegova podmontiranja podređenima svome nadređenom montiranju."

msgid "Make the mount and its submounts unbindable."
msgstr "Čini montiranje i njegova podmontiranja nepovezivima."

msgid "Mount the filesystem read-write."
msgstr "Montira datotečni sustav za čitanje i pisanje."

msgid "Turn on the silent flag (suppress errors)."
msgstr "Uključuje zastavicu tišine (potiskuje poruke o pogreškama)."

msgid "Make the mount a slave of its master (receive propagation)."
msgstr "Čini montiranje podređenim svojem nadređenom montiranju (prima propagaciju)."

msgid "Make the mount shared with peer mounts."
msgstr "Čini montiranje dijeljenim s ostalim montiranjima."

msgid "Update access times on every access (full atime)."
msgstr "Ažurira vremena pristupa pri svakom pristupu (potpuni atime)."

msgid "Honor setuid or setgid bits and file capabilities."
msgstr "Poštuje setuid ili setgid bitove i sposobnosti datoteka."

msgid "All I/O to the filesystem is done synchronously."
msgstr "Sve U/I operacije na datotečnom sustavu izvode se sinkrono."

msgid "Make the mount unbindable."
msgstr "Čini montiranje nepovezivim."

msgid "Allow an ordinary user to mount the filesystem."
msgstr "Dopušta običnome korisniku montiranje datotečnog sustava."

msgid "Allow every user to mount and unmount the filesystem."
msgstr "Dopušta svakome korisniku montiranje i odmontiranje datotečnog sustava."

msgid "Restrict automatic filesystem detection to the listed types."
msgstr "Ograničava automatsko prepoznavanje datotečnog sustava na navedene vrste."

msgid "Set the group that may unmount the mount."
msgstr "Postavlja grupu koja smije odmontirati montiranje."

msgid "Create an idmapped mount using the given ID mapping."
msgstr "Stvara idmapped montiranje koristeći zadano ID mapiranje."

msgid "Create the mountpoint directory if it does not exist."
msgstr "Stvara direktorij točke montiranja ako ne postoji."

msgid "Set the mountpoint directory mode after mounting."
msgstr "Postavlja dozvole direktorija točke montiranja nakon montiranja."

msgid "Do not canonicalize mount source and target paths."
msgstr "Ne kanonizira putanje izvora i cilja montiranja."

msgid "Do not create a loop device even if the source is a regular file."
msgstr "Ne stvara loop uređaj čak i ako je izvor obična datoteka."

msgid "Set the owner that may unmount the mount."
msgstr "Postavlja vlasnika koji smije odmontirati montiranje."

msgid "Mount a subdirectory of the filesystem instead of its root."
msgstr "Montira poddirektorij datotečnog sustava umjesto njegova korijena."

msgid "Enables POSIX access control lists."
msgstr "Omogućuje POSIX liste kontrole pristupa."

msgid "Disables POSIX access control lists."
msgstr "Onemogućuje POSIX liste kontrole pristupa."

msgid "statfs reports usable blocks minus filesystem overhead."
msgstr "statfs prijavljuje upotrebljive blokove oduzevši režiju datotečnog sustava."

msgid "statfs reports total blocks including overhead."
msgstr "statfs prijavljuje ukupne blokove uključujući režiju."

msgid "Performs mount-time checking; only check=none supported now."
msgstr "Izvodi provjeru prilikom montiranja; trenutačno je podržano samo check=none."

msgid "Skips checking at mount time (default)."
msgstr "Preskače provjeru prilikom montiranja (zadano)."

msgid "Prints debugging info upon each (re)mount."
msgstr "Ispisuje podatke za otklanjanje pogrešaka pri svakom (ponovnom) montiranju."

msgid "Sets behavior on errors: continue, remount-ro, or panic."
msgstr "Postavlja ponašanje pri pogreškama: continue, remount-ro ili panic."

msgid "New files inherit the group ID of their parent directory."
msgstr "Nove datoteke nasljeđuju ID grupe nadređenog direktorija."

msgid "Same as grpid."
msgstr "Isto kao grpid."

msgid "New files take the creating process's fsgid (default)."
msgstr "Nove datoteke uzimaju fsgid procesa koji ih stvara (zadano)."

msgid "Same as nogrpid."
msgstr "Isto kao nogrpid."

msgid "Enables group quota support."
msgstr "Omogućuje podršku za grupne kvote."

msgid "Enables user quota support."
msgstr "Omogućuje podršku za korisničke kvote."

msgid "Enables user quota support (same as usrquota)."
msgstr "Omogućuje podršku za korisničke kvote (isto kao usrquota)."

msgid "Disables all quota support."
msgstr "Onemogućuje svu podršku za kvote."

msgid "Disables 32-bit UIDs/GIDs for old-kernel compatibility."
msgstr "Onemogućuje 32-bitne UID-ove/GID-ove radi kompatibilnosti sa starim kernelima."

msgid "Uses the old inode allocator instead of Orlov."
msgstr "Koristi stari alocirator inodea umjesto Orlovog."

msgid "Uses the Orlov allocator for new inodes (default)."
msgstr "Koristi Orlov alocirator za nove inodee (zadano)."

msgid "Group ID allowed to use reserved filesystem blocks."
msgstr "ID grupe kojoj je dopušteno koristiti rezervirane blokove datotečnog sustava."

msgid "User ID allowed to use reserved filesystem blocks."
msgstr "ID korisnika kojem je dopušteno koristiti rezervirane blokove datotečnog sustava."

msgid "Mounts using an alternate superblock number (recovery)."
msgstr "Montira koristeći alternativni broj superbloka (oporavak)."

msgid "Enables \"user.\" extended attributes."
msgstr "Omogućuje proširene atribute \"user.\"."

msgid "Disables \"user.\" extended attributes."
msgstr "Onemogućuje proširene atribute \"user.\"."

msgid "Enables write barriers in the journal code."
msgstr "Omogućuje prepreke zapisa u kodu dnevnika."

msgid "Sets journal commit interval in seconds (default 5)."
msgstr "Postavlja interval predaje dnevnika u sekundama (zadano 5)."

msgid "Sets data journaling mode: journal, ordered, or writeback."
msgstr "Postavlja način vođenja dnevnika podataka: journal, ordered ili writeback."

msgid "Action on data errors in ordered mode: abort or ignore."
msgstr "Radnja pri pogreškama podataka u ordered načinu rada: abort ili ignore."

msgid "Sets the group quota database file for journaled quotas."
msgstr "Postavlja datoteku baze grupnih kvota za dnevničke kvote."

msgid "Specifies external journal device by major/minor number."
msgstr "Navodi uređaj vanjskog dnevnika pomoću major/minor broja."

msgid "Specifies external journal device by device path."
msgstr "Navodi uređaj vanjskog dnevnika pomoću putanje uređaja."

msgid "Sets quota format: vfsold, vfsv0, or vfsv1."
msgstr "Postavlja format kvota: vfsold, vfsv0 ili vfsv1."

msgid "Does not load the journal on mount."
msgstr "Ne učitava dnevnik prilikom montiranja."
msgid "Does not load the journal on mount (same as noload)."
msgstr "Ne učitava dnevnik prilikom montiranja (isto kao noload)."

msgid "Sets the user quota database file for journaled quotas."
msgstr "Postavlja datoteku baze korisničkih kvota za kvote koje se vode u dnevniku."

msgid "Simulates an ext4_abort() for debugging purposes."
msgstr "Simulira ext4_abort() u svrhu otklanjanja pogrešaka."

msgid "Forces delayed blocks to disk before rename/truncate commits."
msgstr "Forsira zapis odgođenih blokova na disk prije predaje preimenovanja/skraćivanja."

msgid "Disables forced allocation on rename/truncate."
msgstr "Onemogućuje prisilnu alokaciju kod preimenovanja/skraćivanja."

msgid "Tracks metadata blocks internally (debug; off by default)."
msgstr "Interno prati blokove metapodataka (za otklanjanje pogrešaka; standardno isključeno)."

msgid "Disables internal metadata block tracking."
msgstr "Onemogućuje interno praćenje blokova metapodataka."

msgid "Defers block allocation until write-out time."
msgstr "Odgađa alokaciju blokova do trenutka zapisivanja."

msgid "Disables delayed allocation."
msgstr "Onemogućuje odgođenu alokaciju."

msgid "Uses inode mutex for DIO reads (default)."
msgstr "Koristi mutex inodea za DIO čitanja (zadano)."

msgid "Avoids inode mutex for DIO reads for scalability."
msgstr "Izbjegava mutex inodea kod DIO čitanja radi skalabilnosti."

msgid "Issues discard/TRIM commands when blocks are freed."
msgstr "Izvršava discard/TRIM naredbe kada se blokovi oslobode."

msgid "Disables issuing discard/TRIM commands."
msgstr "Onemogućuje izvršavanje discard/TRIM naredbi."

msgid ""
"Sets the case-insensitive lookup charset for casefolded directories (e.g. "
"utf8-12.1)."
msgstr "Postavlja znakovni skup za pretraživanje bez razlikovanja velikih i malih slova za mape s preslikavanjem slučaja (npr. utf8-12.1)."

msgid "Sets flags controlling casefold behavior (e.g. strict)."
msgstr "Postavlja zastavice koje upravljaju ponašanjem preslikavanja slučaja (npr. strict)."

msgid ""
"Enables fast commits, a lightweight journaling mode for lower commit latency."
msgstr "Omogućuje brze predaje, lagani način vođenja dnevnika za manju latenciju predaje."

msgid "Tunes the lazy inode-table initialization speed."
msgstr "Podešava brzinu postupne inicijalizacije tablice inodea."

msgid "Does not initialize inode tables in the background."
msgstr "Ne inicijalizira tablice inodea u pozadini."

msgid "Max inode table blocks pre-read during mount."
msgstr "Najveći broj blokova tablice inodea koji se unaprijed čita tijekom montiranja."

msgid "Enables 64-bit inode version support."
msgstr "Omogućuje podršku za 64-bitne verzije inodea."

msgid "Writes commit block without waiting for descriptors."
msgstr "Zapisuje blok predaje bez čekanja deskriptora."

msgid "Enables checksumming of journal transactions."
msgstr "Omogućuje kontrolne zbrojeve transakcija dnevnika."

msgid "Disables journal transaction checksumming."
msgstr "Onemogućuje kontrolne zbrojeve transakcija dnevnika."

msgid "Sets I/O priority for journal commits (0-7)."
msgstr "Postavlja I/O prioritet za predaje dnevnika (0-7)."

msgid "Max microseconds to wait to batch sync-write operations."
msgstr "Najveći broj mikrosekundi čekanja za grupiranje operacija sinkronog pisanja."

msgid "Limits maximum directory size in kilobytes."
msgstr "Ograničava najveću veličinu mape u kilobajtima."

msgid "Minimum commit time for batch optimization (us)."
msgstr "Najmanje vrijeme predaje za optimizaciju grupiranja (us)."

msgid "Disables write barriers."
msgstr "Onemogućuje barijere zapisa."

msgid "Disables mbcache for extended attribute deduplication."
msgstr "Onemogućuje mbcache za dedupliciranje proširenih atributa."

msgid "Enables project quota support."
msgstr "Omogućuje podršku za projektne kvote."

msgid "Sets stripe width (blocks) for mballoc allocation alignment."
msgstr "Postavlja širinu trake (u blokovima) za poravnanje alokacije mballoc."

msgid "Sets end-of-file preallocation size for buffered I/O."
msgstr "Postavlja veličinu pretalokacije na kraju datoteke za međuspremnički I/O."

msgid "Enables opportunistic inline xattr format; deprecated since 5.10."
msgstr "Omogućuje oportunistički ugrađeni (inline) format proširenih atributa; zastarjelo od 5.10."

msgid "Disables attr2 format; deprecated, rejected on CRC filesystems."
msgstr "Onemogućuje attr2 format; zastarjelo, odbacuje se na CRC datotečnim sustavima."

msgid "Sets direct-access mode: never, always, or inode."
msgstr "Postavlja način izravnog pristupa: never, always ili inode."

msgid "Issues commands to reclaim freed blocks (SSD-friendly)."
msgstr "Izvršava naredbe za vraćanje oslobođenih blokova (pogodno za SSD-ove)."

msgid "Disables issuing discard commands."
msgstr "Onemogućuje izvršavanje discard naredbi."

msgid "Applies filestreams allocation mode to whole filesystem."
msgstr "Primjenjuje način alokacije tokova datoteka (filestreams) na cijeli datotečni sustav."

msgid "Enables group quota accounting without enforcement."
msgstr "Omogućuje evidentiranje grupnih kvota bez provođenja."

msgid "Enables group quota accounting and enforcement."
msgstr "Omogućuje evidentiranje grupnih kvota s provođenjem."

msgid "Same as gquota."
msgstr "Isto kao gquota."

msgid "New files inherit the parent directory's group ID."
msgstr "Nove datoteke nasljeđuju ID grupe nadređene mape."

msgid "New files take the process's fsgid (default)."
msgstr "Nove datoteke dobivaju fsgid procesa (zadano)."

msgid "Keeps empty inode clusters on disk; deprecated since 5.10."
msgstr "Zadržava prazne skupove inodea na disku; zastarjelo od 5.10."

msgid "Recycles empty inode clusters; deprecated since 5.10."
msgstr "Ponovno koristi prazne skupove inodea; zastarjelo od 5.10."

msgid "Restricts inode numbers to 32 bits."
msgstr "Ograničava brojeve inodea na 32 bita."

msgid "Allows 64-bit inode numbers (default)."
msgstr "Dopušta 64-bitne brojeve inodea (zadano)."

msgid "Reports swidth/allocsize as st_blksize."
msgstr "Prijavljuje swidth/allocsize kao st_blksize."

msgid "Reports minimal st_blksize (default)."
msgstr "Prijavljuje minimalni st_blksize (zadano)."

msgid "Sets number of in-memory log buffers (2-8)."
msgstr "Postavlja broj međuspremnika dnevnika u memoriji (2-8)."

msgid "Sets size of each in-memory log buffer."
msgstr "Postavlja veličinu svakog međuspremnika dnevnika u memoriji."

msgid "Uses an external log (metadata journal) device."
msgstr "Koristi vanjski uređaj dnevnika (dnevnik metapodataka)."

msgid "Skips stripe-unit alignment for data allocations."
msgstr "Preskače poravnavanje po jedinicama trake za alokacije podataka."

msgid "Mounts without running log recovery (read-only)."
msgstr "Montira bez pokretanja oporavka dnevnika (samo za čitanje)."

msgid "Skips duplicate-UUID mount detection."
msgstr "Preskače otkrivanje montiranja s dupliciranim UUID-om."

msgid "Forcibly turns off all quota accounting and enforcement."
msgstr "Prisilno isključuje sva evidentiranja i provođenja kvota."

msgid "Enables project quota accounting and enforcement."
msgstr "Omogućuje evidentiranje projektnih kvota s provođenjem."

msgid "Enables project quota accounting without enforcement."
msgstr "Omogućuje evidentiranje projektnih kvota bez provođenja."

msgid "Same as pquota."
msgstr "Isto kao pquota."

msgid "Enables user quota accounting without enforcement."
msgstr "Omogućuje evidentiranje korisničkih kvota bez provođenja."

msgid "Enables user quota accounting and enforcement."
msgstr "Omogućuje evidentiranje korisničkih kvota s provođenjem."

msgid "Uses an external realtime-section device."
msgstr "Koristi vanjski uređaj za realtime odjeljak."

msgid "Sets stripe unit in 512-byte blocks."
msgstr "Postavlja jedinicu trake u 512-bajtnim blokovima."

msgid "Rounds data allocations up to stripe-width boundaries."
msgstr "Zaokružuje alokacije podataka prema gore na granice širine trake."

msgid "Sets stripe width in 512-byte blocks."
msgstr "Postavlja širinu trake u 512-bajtnim blokovima."

msgid "Same as uquota."
msgstr "Isto kao uquota."

msgid "Runs filesystem namespace operations synchronously."
msgstr "Izvršava operacije nad prostorom naziva datotečnog sustava sinkrono."

msgid "Enables POSIX access control lists (default on)."
msgstr "Omogućuje POSIX popise kontrole pristupa (standardno omogućeno)."

msgid "Auto-defragments detected small random writes."
msgstr "Automatski defragmentira otkrivene male nasumične upise."

msgid "Disables automatic file defragmentation."
msgstr "Onemogućuje automatsku defragmentaciju datoteka."

msgid "Ensures writes flush to permanent storage at checkpoints."
msgstr "Osigurava ispraznjivanje zapisa u trajnu pohranu na kontrolnim točkama."

msgid "Disables write barriers; risks corruption on crash."
msgstr "Onemogućuje barijere zapisa; postoji rizik od oštećenja pri padu."

msgid "Clears and rebuilds the free space cache."
msgstr "Briše i ponovno izgrađuje predmemoriju slobodnog prostora."

msgid "Sets transaction commit interval in seconds (default 30)."
msgstr "Postavlja interval predaje transakcija u sekundama (zadano 30)."

msgid "Enables data compression (zlib, lzo, or zstd)."
msgstr "Omogućuje kompresiju podataka (zlib, lzo ili zstd)."

msgid "Always attempts compression, even if ineffective."
msgstr "Uvijek pokušava kompresiju, čak i ako je neučinkovita."

msgid "Enables data copy-on-write for new files."
msgstr "Omogućuje kopiranje pri pisanju (copy-on-write) podataka za nove datoteke."

msgid "Disables data COW (implies nodatasum, no compression)."
msgstr "Onemogućuje COW za podatke (podrazumijeva nodatasum, bez kompresije)."

msgid "Enables data checksumming."
msgstr "Omogućuje kontrolne zbrojeve podataka."

msgid "Disables data checksumming."
msgstr "Onemogućuje kontrolne zbrojeve podataka."

msgid "Allows mount with fewer devices than RAID requires."
msgstr "Dopušta montiranje s manje uređaja nego što RAID zahtijeva."

msgid "Scans the given device for btrfs during mount."
msgstr "Traži btrfs na danom uređaju tijekom montiranja."

msgid "Discards freed file blocks (TRIM)."
msgstr "Odbacuje oslobođene blokove datoteka (TRIM)."

msgid "Disables discarding of freed blocks."
msgstr "Onemogućuje odbacivanje oslobođenih blokova."

msgid "Enables verbose output for ENOSPC conditions."
msgstr "Omogućuje opsežan ispis za ENOSPC stanja."

msgid "Disables verbose ENOSPC output."
msgstr "Onemogućuje opsežan ENOSPC ispis."

msgid "Sets action on fatal errors: bug or panic."
msgstr "Postavlja radnju pri fatalnim pogreškama: bug ili panic."

msgid "Flushes all prior-transaction data at each commit."
msgstr "Isprazni sve podatke prijašnjih transakcija pri svakoj predaji."

msgid "Disables forced full flush on commit."
msgstr "Onemogućuje prisilno potpuno ispraznjivanje pri predaji."

msgid "Intentionally fragments block groups (debug builds only)."
msgstr "Namjerno fragmentira blokovske grupe (samo u debug verzijama)."

msgid "Max bytes that can be inlined in a metadata leaf."
msgstr "Najveći broj bajtova koji se može ugraditi u list metapodataka."

msgid "Allocates one metadata chunk per N data chunks."
msgstr "Alocira jedan segment metapodataka na svakih N segmenata podataka."

msgid "Does not replay the tree log (same as norecovery)."
msgstr "Ne reproducira dnevnik stabla (isto kao norecovery)."

msgid "Does not attempt recovery at mount time."
msgstr "Ne pokušava oporavak prilikom montiranja."

msgid "Forces rebuild of the UUID tree."
msgstr "Forsira ponovnu izgradnju UUID stabla."

msgid ""
"Applies recovery workarounds: usebackuproot, nologreplay, ignorebadroots, "
"ignore*sums, or all (read-only)."
msgstr "Primjenjuje zaobilazna rješenja za oporavak: usebackuproot, nologreplay, ignorebadroots, ignore*sums ili all (samo za čitanje)."

msgid "Skips automatic resume of an interrupted balance."
msgstr "Preskače automatski nastavak prekinutog balansiranja."

msgid "Enables free space caching (v1 or v2)."
msgstr "Omogućuje predmemoriju slobodnog prostora (v1 ili v2)."

msgid "Disables the free space cache."
msgstr "Onemogućuje predmemoriju slobodnog prostora."

msgid "Enables SSD allocation optimizations."
msgstr "Omogućuje optimizacije alokacije za SSD-ove."

msgid "Disables SSD allocation optimizations."
msgstr "Onemogućuje optimizacije alokacije za SSD-ove."

msgid "Allocates into larger aligned chunks for low-end SSDs."
msgstr "Alocira u veće poravnate segmente za SSD-ove niže klase."

msgid "Disables the ssd_spread allocation scheme."
msgstr "Onemogućuje shemu alokacije ssd_spread."

msgid "Mounts a subvolume at the given path, not the toplevel."
msgstr "Montira podvolumen na zadanoj putanji, a ne najvišu razinu."

msgid "Mounts the subvolume with the given numeric ID."
msgstr "Montira podvolumen s danim numeričkim ID-om."

msgid "Sets number of worker threads."
msgstr "Postavlja broj radnih niti."

msgid "Enables tree logging for fsync/O_SYNC."
msgstr "Omogućuje vođenje dnevnika stabla za fsync/O_SYNC."

msgid "Disables tree logging."
msgstr "Onemogućuje vođenje dnevnika stabla."

msgid "Tries backup roots if the tree root is bad; removed since 7.3."
msgstr "Pokušava sigurnosne korijene ako je korijen stabla neispravan; uklonjeno od verzije 7.3."

msgid "Lets subvolume owners delete their own subvolumes."
msgstr "Dopušta vlasnicima podvolumena brisanje vlastitih podvolumena."

msgid "Sets number of active log segments (2, 4, or 6)."
msgstr "Postavlja broj aktivnih segmenata dnevnika (2, 4 ili 6)."

msgid "Enables age extent cache for allocation hints."
msgstr "Omogućuje predmemoriju starosti opsega (extent) za upute pri alokaciji."

msgid "Sets block allocation policy: reuse or default."
msgstr "Postavlja politiku alokacije blokova: reuse ili default."

msgid "Enables age-threshold background garbage collection."
msgstr "Omogućuje pozadinsko prikupljanje otpada prema pragu starosti."

msgid "Turns background garbage collection on/off/sync."
msgstr "Postavlja pozadinsko prikupljanje otpada: on/off/sync."

msgid "Allows cache_flush commands to be issued."
msgstr "Dopušta izvršavanje cache_flush naredbi."

msgid "Skips cache_flush commands if storage guarantees order."
msgstr "Preskače cache_flush naredbe ako pohrana jamči redoslijed."

msgid "Enables or disables checkpointing (disable/enable)."
msgstr "Omogućuje ili onemogućuje kontrolne točke (disable/enable)."

msgid "Merges concurrent checkpoint requests via a daemon."
msgstr "Spaja istovremene zahtjeve za kontrolnim točkama putem demona."

msgid "Disables checkpoint merge feature."
msgstr "Onemogućuje značajku spajanja kontrolnih točaka."

msgid "Selects compression algorithm (lzo, lz4, zstd)."
msgstr "Odabire algoritam kompresije (lzo, lz4, zstd)."

msgid "Caches compressed blocks to improve read hit ratio."
msgstr "Sprema komprimirane blokove u predmemoriju radi boljeg omjera pogodaka čitanja."

msgid "Verifies checksums of compressed clusters."
msgstr "Provjerava kontrolne zbrojeve komprimiranih klastera."

msgid "Adds extensions whose files are auto-compressed."
msgstr "Dodaje nastavke čije se datoteke automatski komprimiraju."

msgid "Sets compress cluster size in 4KB units."
msgstr "Postavlja veličinu klastera za kompresiju u jedinicama od 4 KB."

msgid "Sets compression mode: fs (auto) or user (manual)."
msgstr "Postavlja način kompresije: fs (automatski) ili user (ručno)."

msgid "Flushes data before checkpoint to persist regular files."
msgstr "Isprazni podatke prije kontrolne točke kako bi se trajno sačuvale obične datoteke."

msgid "Ignores mkfs extension list for cold-file detection."
msgstr "Zanemaruje popis nastavaka iz mkfs za otkrivanje hladnih datoteka."

msgid "Disables the roll-forward recovery routine."
msgstr "Onemogućuje rutinu oporavka roll-forward."

msgid "Enables real-time discard/TRIM commands."
msgstr "Omogućuje discard/TRIM naredbe u stvarnom vremenu."

msgid "Disables real-time discard."
msgstr "Onemogućuje discard u stvarnom vremenu."

msgid "Sets discard alignment unit: block, segment, or section."
msgstr "Postavlja jedinicu poravnanja odbacivanja: block, segment ili section."

msgid "Sets behavior on critical errors: panic, continue, remount-ro."
msgstr "Postavlja ponašanje pri kritičnim pogreškama: panic, continue, remount-ro."

msgid "Enables the rb-tree extent cache (default)."
msgstr "Omogućuje predmemoriju opsega rb-stabla (zadano)."

msgid "Disables the extent cache."
msgstr "Onemogućuje predmemoriju opsega."

msgid "Reduces mount time at the cost of normal performance."
msgstr "Smanjuje vrijeme montiranja na štetu uobičajene izvedbe."

msgid "Enables fault injection at a given rate (testing)."
msgstr "Omogućuje ubrizgavanje pogrešaka zadanom stopom (testiranje)."

msgid "Configures which fault types to inject (testing)."
msgstr "Konfigurira koje će se vrste pogrešaka ubrizgati (testiranje)."

msgid "Merges concurrent cache_flush commands."
msgstr "Spaja istovremene cache_flush naredbe."

msgid "Sets fsync policy: posix, strict, or nobarrier."
msgstr "Postavlja politiku fsync: posix, strict ili nobarrier."

msgid "Handles foreground GC in the background GC thread."
msgstr "Obavlja prednje prikupljanje otpada (GC) u pozadinskoj GC niti."
msgid "Disables GC merge feature."
msgstr "Onemogućuje značajku spajanja GC-a."

msgid "Points to group journaled quota file."
msgstr "Pokazuje na datoteku grupne kvote s vođenjem dnevnika."

msgid "Enables group disk quota accounting."
msgstr "Omogućuje evidenciju diskovne kvote za grupe."

msgid "Allocates segments heap-based from disk end; deprecated."
msgstr "Dodjeljuje segmente na temelju gomile od kraja diska; zastarjelo."

msgid "Disables heap-based allocation; deprecated."
msgstr "Onemogućuje dodjelu na temelju gomile; zastarjelo."

msgid "Stores small file data inside the inode block."
msgstr "Pohranjuje podatke malih datoteka unutar bloka inoda."

msgid "Stores directory entries inside the inode block."
msgstr "Pohranjuje unose direktorija unutar bloka inoda."

msgid "Disables the inline dentry feature."
msgstr "Onemogućuje značajku inline unosa direktorija (dentry)."

msgid "Enables inline extended attributes."
msgstr "Omogućuje inline proširene atribute."

msgid "Disables inline extended attributes."
msgstr "Onemogućuje inline proširene atribute."

msgid "Sets the inline xattr size."
msgstr "Postavlja veličinu inline xattr-a."

msgid "Uses blk-crypto for inline encryption hardware."
msgstr "Koristi blk-crypto za hardver inline šifriranja."

msgid "Sets casefold directory lookup: perf, compat, or auto."
msgstr "Postavlja pretragu direktorija uz zanemarivanje velikih i malih slova: perf, compat ili auto."

msgid "Sets memory mode: normal or low."
msgstr "Postavlja memorijski način rada: normal ili low."

msgid "Sets block allocation mode: adaptive or lfs."
msgstr "Postavlja način dodjele blokova: adaptive ili lfs."

msgid "Enables faster full/empty NAT block access."
msgstr "Omogućuje brži pristup punim/praznim NAT blokovima."

msgid "Disables the inline data feature."
msgstr "Onemogućuje značajku inline podataka."

msgid "Disables roll-forward recovery and mounts read-only."
msgstr "Onemogućuje roll-forward oporavak i montira datotečni sustav samo za čitanje."

msgid "Disables user extended attributes."
msgstr "Onemogućuje korisničke proširene atribute."

msgid "Disables all plain disk quota options."
msgstr "Onemogućuje sve obične opcije diskovne kvote."

msgid "Points to project journaled quota file."
msgstr "Pokazuje na datoteku projektne kvote s vođenjem dnevnika."

msgid "Enables project quota accounting."
msgstr "Omogućuje evidenciju projektne kvote."

msgid "Enables plain user disk quota accounting."
msgstr "Omogućuje običnu evidenciju diskovne kvote za korisnike."

msgid "Sets reserved nodes for privileged-user allocation."
msgstr "Postavlja broj rezerviranih čvorova za dodjelu povlaštenim korisnicima."

msgid "Sets reserved space (%) for privileged-user allocation."
msgstr "Postavlja rezervirani prostor (%) za dodjelu povlaštenim korisnicima."

msgid "Group ID with access to reserved blocks and nodes."
msgstr "ID grupe s pristupom rezerviranim blokovima i čvorovima."

msgid "User ID with access to reserved blocks and nodes."
msgstr "ID korisnika s pristupom rezerviranim blokovima i čvorovima."

msgid "Enables dummy fscrypt context for testing."
msgstr "Omogućuje lažni (dummy) fscrypt kontekst za testiranje."

msgid "Points to user journaled quota file."
msgstr "Pokazuje na datoteku korisničke kvote s vođenjem dnevnika."

msgid "Enables user disk quota accounting."
msgstr "Omogućuje evidenciju diskovne kvote za korisnike."

msgid "Enables POSIX Access Control List support."
msgstr "Omogućuje podršku za POSIX popise kontrole pristupa (ACL)."

msgid "Enables TRIM support for SSD delete performance."
msgstr "Omogućuje TRIM podršku za bolje performanse brisanja na SSD-u."

msgid "Permission mask for directories."
msgstr "Maska dozvola za direktorije."

msgid "Permission mask for files."
msgstr "Maska dozvola za datoteke."

msgid "Forces mounting even if the volume is dirty (not recommended)."
msgstr "Prisiljava montiranje čak i ako je volumen „prljav” (nije preporučeno)."

msgid "Default group ID for created files and directories."
msgstr "Zadani ID grupe za stvorene datoteke i direktorije."

msgid "Sets the HIDDEN attribute for names starting with a dot."
msgstr "Postavlja atribut HIDDEN za nazive koji počinju točkom."

msgid "Charset used to translate path strings to Unicode."
msgstr "Skup znakova koji se koristi za pretvaranje nizova putanja u Unicode."

msgid "Hides files with the Windows HIDDEN attribute."
msgstr "Skriva datoteke s Windows atributom HIDDEN."

msgid "Preallocates space to reduce write fragmentation."
msgstr "Predodjeljuje prostor radi smanjenja fragmentacije pri zapisivanju."

msgid "Shows all NTFS meta-files (system files)."
msgstr "Prikazuje sve NTFS meta-datoteke (sistemske datoteke)."

msgid "Creates new files as sparse."
msgstr "Stvara nove datoteke kao rijetke (sparse)."

msgid "Marks files with the SYSTEM attribute as immutable."
msgstr "Označava datoteke sa SYSTEM atributom kao nepromjenjive."

msgid "Default user ID for created files and directories."
msgstr "Zadani ID korisnika za stvorene datoteke i direktorije."

msgid "Default permission mask for files and directories."
msgstr "Zadana maska dozvola za datoteke i direktorije."

msgid "Rejects filenames not allowed by Windows."
msgstr "Odbacuje nazive datoteka koje Windows ne dopušta."

msgid "Relaxes utime() permission checks for changing timestamps."
msgstr "Popušta provjere dozvola utime() za promjenu vremenskih oznaka."

msgid "Sets the block size; obsolete."
msgstr "Postavlja veličinu bloka; zastarjelo."

msgid "Sets case-sensitivity checking (strict, relaxed, or normal)."
msgstr "Postavlja provjeru osjetljivosti na velika i mala slova (strict, relaxed ili normal)."

msgid "Sets codepage for converting to shortname characters."
msgstr "Postavlja kodnu stranicu za pretvorbu u znakove kratkih naziva."

msgid "Obsolete; may fail or be ignored."
msgstr "Zastarjelo; može zakazati ili biti zanemareno."

msgid "Obsolete; forces use of a CVF compressed-volume module."
msgstr "Zastarjelo; prisiljava upotrebu CVF modula za komprimirane volumene."

msgid "Obsolete; passes an option to the CVF module."
msgstr "Zastarjelo; prosljeđuje opciju CVF modulu."

msgid "Enables debug output; unused by current implementation."
msgstr "Omogućuje debug ispis; trenutačna implementacija ga ne koristi."

msgid "Uses DOS 1.x BIOS Parameter Block defaults for small floppies."
msgstr "Koristi zadane vrijednosti DOS 1.x BIOS bloka parametara (BPB) za male diskete."

msgid "Forces DOS dot conventions on filenames (obsolete)."
msgstr "Prisiljava DOS konvencije točaka na nazivima datoteka (zastarjelo)."

msgid "Forces Unix-style names without DOS dots (obsolete)."
msgstr "Prisiljava nazive u Unix stilu bez DOS točaka (zastarjelo)."

msgid "Allows dots in 8.3 short names (obsolete)."
msgstr "Dopušta točke u kratkim 8.3 nazivima (zastarjelo)."

msgid "Sets FAT behavior on errors: panic, continue, or remount-ro."
msgstr "Postavlja ponašanje FAT-a pri pogreškama: panic, continue ili remount-ro."

msgid "Forces FAT type 12, 16, or 32, overriding auto-detection."
msgstr "Prisiljava FAT vrstu 12, 16 ili 32, nadjačavajući automatsko otkrivanje."

msgid "Flushes data to disk earlier than normal."
msgstr "Ispire podatke na disk ranije nego što je uobičajeno."

msgid "Permission mask for regular files."
msgstr "Maska dozvola za obične datoteke."

msgid "Group ID applied to all files."
msgstr "ID grupe primijenjen na sve datoteke."

msgid "Charset converting filenames between disk and Unicode."
msgstr "Skup znakova koji pretvara nazive datoteka između diska i Unicoda."

msgid "Enables NFS export support (stale_rw or nostale_ro)."
msgstr "Omogućuje podršku za NFS izvoz (stale_rw ili nostale_ro)."

msgid "Deprecated; use shortname=win95 instead."
msgstr "Zastarjelo; umjesto toga koristite shortname=win95."

msgid "Skips the ~number tail in 8.3 aliases when possible."
msgstr "Preskače nastavak ~broj u 8.3 aliasima kad god je to moguće."

msgid "Obsolete; allowed files differing only in case."
msgstr "Zastarjelo; dopuštao je datoteke koje se razlikuju samo po velikim i malim slovima."

msgid "Suppresses warning messages and chmod/chown errors."
msgstr "Potiskuje poruke upozorenja i pogreške chmod/chown."

msgid "Treats the FAT read-only attribute as read-only for directories."
msgstr "Tretira FAT atribut samo za čitanje kod direktorija kao stvarno samo za čitanje."

msgid "Sets 8.3 short-name display/create mode (lower, win95, winnt, mixed)."
msgstr "Postavlja način prikaza/stvaranja kratkih 8.3 naziva (lower, win95, winnt, mixed)."

msgid "Allows execute permission only for .EXE, .COM, or .BAT files."
msgstr "Dopušta dozvolu izvršavanja samo za .EXE, .COM ili .BAT datoteke."

msgid "Treats the FAT system attribute as the immutable flag."
msgstr "Tretira FAT sistemski atribut kao zastavicu nepromjenjivosti."

msgid "Sets minute offset converting FAT local time to UTC."
msgstr "Postavlja pomak u minutama za pretvorbu FAT lokalnog vremena u UTC."

msgid "Interprets timestamps as UTC instead of local time."
msgstr "Tumači vremenske oznake kao UTC umjesto lokalnog vremena."

msgid "Owner user ID applied to all files."
msgstr "ID korisnika-vlasnika primijenjen na sve datoteke."

msgid "Permission mask for files and directories."
msgstr "Maska dozvola za datoteke i direktorije."

msgid "Escapes unhandled Unicode characters as :XXXX sequences."
msgstr "Kodira neobrađene Unicode znakove kao :XXXX nizove."

msgid "Uses the free-cluster count stored in FSINFO."
msgstr "Koristi broj slobodnih klastera spremljen u FSINFO."

msgid "Use UTF-8 to encode long file names."
msgstr "Koristi UTF-8 za kodiranje dugih naziva datoteka."

msgid "Deprecated; accepted but has no effect."
msgstr "Zastarjelo; prihvaćeno, ali nema učinka."

msgid "Sets behavior on errors: panic, continue, or remount-ro."
msgstr "Postavlja ponašanje pri pogreškama: panic, continue ili remount-ro."

msgid "Default group ID applied to all files."
msgstr "Zadani ID grupe primijenjen na sve datoteke."

msgid "Keeps trailing periods in path components and filenames."
msgstr "Zadržava točke na kraju komponenti putanje i naziva datoteka."

msgid "Uses the system timezone for timestamps lacking a valid offset."
msgstr "Koristi vremensku zonu sustava za vremenske oznake bez valjanog pomaka."

msgid "Sets minute offset converting timestamps to UTC."
msgstr "Postavlja pomak u minutama za pretvorbu vremenskih oznaka u UTC."

msgid "Default user ID applied to all files."
msgstr "Zadani ID korisnika primijenjen na sve datoteke."

msgid "Creates directories with zero size, allocating no cluster."
msgstr "Stvara direktorije nulte veličine bez dodjele klastera."

msgid "Enables swap discard; supports discard=once or discard=pages."
msgstr "Omogućuje discard za swap; podržava discard=once ili discard=pages."

msgid "Sets the swap device priority (0-32767)."
msgstr "Postavlja prioritet swap uređaja (0-32767)."

msgid "Maximum seconds to cache directory attributes."
msgstr "Najviše sekundi predmemoriranja atributa direktorija."

msgid "Maximum seconds to cache regular file attributes."
msgstr "Najviše sekundi predmemoriranja atributa običnih datoteka."

msgid "Seconds to cache file/directory attributes before re-checking."
msgstr "Sekunde predmemoriranja atributa datoteka/direktorija prije ponovne provjere."

msgid "Sets the destination IP address of the server."
msgstr "Postavlja odredišnu IP adresu poslužitelja."

msgid "Members of this group open files with backup intent."
msgstr "Članovi ove grupe otvaraju datoteke s namjerom sigurnosnog kopiranja."

msgid "This user opens files with backup intent."
msgstr "Ovaj korisnik otvara datoteke s namjerom sigurnosnog kopiranja."

msgid "Overrides the default block size reported on SMB3 files."
msgstr "Nadjačava zadanu veličinu bloka koja se prijavljuje za SMB3 datoteke."

msgid "Cache mode for file data: none, strict or loose."
msgstr "Način predmemoriranja podataka datoteka: none, strict ili loose."

msgid "Maps CIFS/NTFS ACLs and SIDs to/from Linux permissions."
msgstr "Preslikava CIFS/NTFS ACL-ove i SID-ove u/iz Linux dozvola."

msgid "Max seconds to defer the final SMB3 file close."
msgstr "Najviše sekundi odgode konačnog zatvaranja SMB3 datoteke."

msgid "Enables experimental SMB 3.1.1 message compression."
msgstr "Omogućuje eksperimentalnu kompresiju SMB 3.1.1 poruka."

msgid "Reads username/password from a credentials file."
msgstr "Čita korisničko ime/lozinku iz datoteke s vjerodajnicama."

msgid "Uid owning the credentials cache (useful with krb5)."
msgstr "Uid koji posjeduje predmemoriju vjerodajnica (korisno uz krb5)."

msgid "Overrides the default mode for directories."
msgstr "Nadjačava zadani mod dozvola za direktorije."

msgid "Sets the user's domain (workgroup)."
msgstr "Postavlja domenu (radnu grupu) korisnika."

msgid "Auto-guesses the server domain from the NTLM challenge."
msgstr "Automatski pogađa domenu poslužitelja iz NTLM izazova."

msgid "Keeps unsupported permissions in memory only; unreliable."
msgstr "Nepodržane dozvole čuva samo u memoriji; nepouzdano."

msgid "Seconds between keepalive echo requests."
msgstr "Sekunde između keepalive echo zahtjeva."

msgid "Min encrypted-read size before offloading decryption."
msgstr "Minimalna veličina šifriranog čitanja prije prebacivanja dešifriranja."

msgid "Overrides the default mode for regular files."
msgstr "Nadjačava zadani mod dozvola za obične datoteke."

msgid "Ignores server gid and always uses the gid value."
msgstr "Zanemaruje gid poslužitelja i uvijek koristi vrijednost gid."

msgid "Ignores server uid and always uses the uid value."
msgstr "Zanemaruje uid poslužitelja i uvijek koristi vrijednost uid."

msgid "Always uses CIFS-style mandatory locks."
msgstr "Uvijek koristi obvezno zaključavanje u CIFS stilu."

msgid "Enables local disk caching via FS-Cache."
msgstr "Omogućuje lokalno predmemoriranje na disk putem FS-Cachea."

msgid "Default gid owning files when the server gives none."
msgstr "Zadani gid za datoteke kada poslužitelj ne navede vlasnika."

msgid "Don't prompt for a password; mount as guest."
msgstr "Ne traži unos lozinke; montira kao gost."

msgid "Keeps the share root directory handle cached."
msgstr "Zadržava ručicu korijenskog direktorija dijeljenog resursa u predmemoriji."

msgid "Ms the server reserves handles after failover."
msgstr "Milisekundi tijekom kojih poslužitelj zadržava ručice nakon failovera."

msgid "Hangs when the server crashes instead of erroring."
msgstr "Zaglavi se kada se poslužitelj sruši umjesto da prijavi pogrešku."

msgid "Extracts uid/gid from a special SID instead of mapping."
msgstr "Izvlači uid/gid iz posebnog SID-a umjesto preslikavanja."

msgid "Synonym for nocase; case-insensitive matching."
msgstr "Sinonim za nocase; podudaranje bez razlikovanja velikih i malih slova."

msgid "Allow interrupts while hung; currently unimplemented."
msgstr "Dopušta prekide tijekom zaglavljenosti; trenutačno nije implementirano."

msgid "Charset for converting path names to/from Unicode."
msgstr "Skup znakova za pretvorbu naziva putanja u/iz Unicoda."

msgid "Enables Unix Extensions (synonym for posix/unix)."
msgstr "Omogućuje Unix proširenja (sinonim za posix/unix)."

msgid "Checks cached leases locally instead of querying server."
msgstr "Provjerava predmemorirane najmove (lease) lokalno umjesto slanja upita poslužitelju."

msgid "Translates reserved Windows filename characters."
msgstr "Prevodi rezervirane Windows znakove u nazivima datoteka."

msgid "Maps reserved characters per Microsoft Services For Mac."
msgstr "Preslikava rezervirane znakove prema shemi Microsoft Services For Mac."

msgid "Maximum number of cached directories per share."
msgstr "Najveći broj predmemoriranih direktorija po dijeljenom resursu."

msgid "Number of multichannel transport connections (max 16)."
msgstr "Broj transportnih veza za višekanalni rad (najviše 16)."

msgid "Maximum SMB2 credits the client can hold."
msgstr "Najveći broj SMB2 kredita koje klijent može držati."

msgid "Enables Minshall+French symlink support."
msgstr "Omogućuje podršku za simboličke poveznice Minshall+French."

msgid "Uses multiple transport connections for one session."
msgstr "Koristi više transportnih veza za jednu sesiju."

msgid "Maps each user's access to individual credentials."
msgstr "Preslikava pristup svakog korisnika na zasebne vjerodajnice."

msgid "Client netbios name used for port 139 connections."
msgstr "NetBIOS naziv klijenta koji se koristi za veze na port 139."

msgid "Disables POSIX ACL operations."
msgstr "Onemogućuje POSIX ACL operacije."

msgid "Uses fixed kernel socket buffer sizes."
msgstr "Koristi fiksne veličine međuspremnika utičnica jezgre."

msgid "Don't send byte-range lock requests to the server."
msgstr "Ne šalje poslužitelju zahtjeve za zaključavanjem raspona bajtova."

msgid "Requests case-insensitive path name matching."
msgstr "Zahtijeva podudaranje naziva putanja bez razlikovanja velikih i malih slova."

msgid "Don't follow Distributed FileSystem referrals."
msgstr "Ne slijedi uputnice (referrals) distribuiranog datotečnog sustava."

msgid "Disables caching of the share root handle."
msgstr "Onemogućuje predmemoriranje ručice korijena dijeljenog resursa."

msgid "Don't allow interrupts; currently unimplemented."
msgstr "Ne dopušta prekide; trenutačno nije implementirano."
msgid "Don't request leases/oplocks when opening files."
msgstr "Ne zahtijeva lease/oplock zaključavanja pri otvaranju datoteka."

msgid "Disables Unix Extensions (synonym for noposix)."
msgstr "Onemogućuje Unix proširenja (sinonim za noposix)."

msgid "Don't translate reserved filename characters."
msgstr "Ne prevodi rezervirane znakove u nazivima datoteka."

msgid "Disables client-side permission checking."
msgstr "Onemogućuje provjeru dozvola na strani klijenta."

msgid "Disables persistent handles."
msgstr "Onemogućuje trajne handle-ove."

msgid "Disables Unix Extensions for this mount."
msgstr "Onemogućuje Unix proširenja za ovo montiranje."

msgid "Don't negotiate POSIX-style pathnames."
msgstr "Ne dogovara putanje datoteka u POSIX stilu."

msgid "Disables resilient handles."
msgstr "Onemogućuje otporne handle-ove."

msgid "Client generates inode numbers locally."
msgstr "Klijent lokalno generira brojeve inoda."

msgid "Lets the server set uid/gid on new files."
msgstr "Omogućuje poslužitelju postavljanje uid/gid na novim datotekama."

msgid "Never reuses existing sockets for new mounts."
msgstr "Nikada ne koristi postojeće utičnice za nova montiranja."

msgid "Don't flush to the server on fsync()."
msgstr "Ne ispire podatke na poslužitelj pri fsync()."

msgid "Disables getfattr/setfattr xattr operations."
msgstr "Onemogućuje xattr operacije getfattr/setfattr."

msgid "Specifies the CIFS password (alias of password)."
msgstr "Određuje CIFS lozinku (alias za password)."

msgid "Specifies an alternate password for password rotation."
msgstr "Određuje zamjensku lozinku za rotaciju lozinki."

msgid "Specifies the CIFS password."
msgstr "Određuje CIFS lozinku."

msgid "Enables client-side permission checking (default)."
msgstr "Omogućuje provjeru dozvola na strani klijenta (zadano)."

msgid "Keeps opened files across reconnections."
msgstr "Zadržava otvorene datoteke tijekom ponovnog povezivanja."

msgid "Port to connect to the CIFS server."
msgstr "Ulaz za povezivanje s CIFS poslužiteljem."

msgid "Enables Unix Extensions for this mount."
msgstr "Omogućuje Unix proširenja za ovo montiranje."

msgid "Allows POSIX-style pathnames (inverse of noposixpaths)."
msgstr "Dopušta putanje u POSIX stilu (obrnuto od noposixpaths)."

msgid "Uses SMB Direct over an RDMA adapter."
msgstr "Koristi SMB Direct preko RDMA adaptera."

msgid "Maximum bytes requested in each read request."
msgstr "Najviše bajtova zatraženo u svakom zahtjevu za čitanje."

msgid "Forwards the opening pid on read/write operations."
msgstr "Prosljeđuje pid otvaranja pri operacijama čitanja/pisanja."

msgid "Encrypts traffic at the SMB layer (SMB3+)."
msgstr "Šifrira promet na SMB sloju (SMB3+)."

msgid ""
"Sets the session security mode (none, krb5, krb5i, ntlm, ntlmi, ntlmv2, "
"ntlmv2i, ntlmssp, ntlmsspi)."
msgstr "Postavlja sigurnosni način sesije (none, krb5, krb5i, ntlm, ntlmi, ntlmv2, ntlmv2i, ntlmssp, ntlmsspi)."

msgid "Server netbios name for old port 139 servers."
msgstr "NetBIOS naziv poslužitelja za stare poslužitelje na ulazu 139."

msgid "Uses inode numbers returned by the server."
msgstr "Koristi brojeve inoda koje vraća poslužitelj."

msgid "Sets uid/gid of processes on newly created files."
msgstr "Postavlja uid/gid procesa za novostvorene datoteke."

msgid "Creates device/fifo files in Services for Unix format."
msgstr "Stvara datoteke uređaja/fifo u formatu Services for Unix."

msgid "Ignores unrecognized mount options following it."
msgstr "Zanemaruje neprepoznate opcije montiranja koje slijede nakon njega."

msgid "Mounts a specific snapshot of the remote share."
msgstr "Montira određenu snimku udaljenog dijeljenog resursa."

msgid "Returns errors instead of hanging when server crashes."
msgstr "Vraća pogreške umjesto zaglavljenja kada se poslužitelj sruši."

msgid "Default uid owning files when the server gives none."
msgstr "Zadani uid vlasnik datoteka kada ga poslužitelj ne dostavi."

msgid "Enables Unix Extensions (synonym for posix)."
msgstr "Omogućuje Unix proširenja (sinonim za posix)."

msgid "Namespace in which kernel upcalls are handled."
msgstr "Imenski prostor u kojem se obrađuju upcall pozivi jezgre."

msgid "Specifies the SMB username (alias of username)."
msgstr "Određuje SMB korisničko ime (alias za username)."

msgid "Specifies the SMB username to connect as."
msgstr "Određuje SMB korisničko ime pod kojim se vrši povezivanje."

msgid "SMB protocol version (e.g. 1.0, 2.1, 3.1.1)."
msgstr "Inačica SMB protokola (npr. 1.0, 2.1, 3.1.1)."

msgid "Maximum bytes sent in each write request."
msgstr "Najviše bajtova poslano u svakom zahtjevu za pisanje."

msgid "Enables attribute caching (default)."
msgstr "Omogućuje predmemoriranje atributa (zadano)."

msgid "Disables attribute caching; makes writes synchronous."
msgstr "Onemogućuje predmemoriranje atributa; čini pisanja sinkronima."

msgid "Max seconds directory attributes are cached."
msgstr "Maksimalan broj sekundi predmemoriranja atributa direktorija."

msgid "Min seconds directory attributes are cached."
msgstr "Minimalan broj sekundi predmemoriranja atributa direktorija."

msgid "Max seconds regular file attributes are cached."
msgstr "Maksimalan broj sekundi predmemoriranja atributa običnih datoteka."

msgid "Min seconds regular file attributes are cached."
msgstr "Minimalan broj sekundi predmemoriranja atributa običnih datoteka."

msgid "Sets all attribute-cache timeouts to this value."
msgstr "Postavlja sva vremenska ograničenja predmemorije atributa na ovu vrijednost."

msgid "Enables the NFSACL sideband protocol."
msgstr "Omogućuje NFSACL protokol bočnog kanala."

msgid "Disables the NFSACL sideband protocol."
msgstr "Onemogućuje NFSACL protokol bočnog kanala."

msgid "Retries a failed mount in the background."
msgstr "Ponovno pokušava neuspjelo montiranje u pozadini."

msgid "Fails the mount in the foreground (default)."
msgstr "Neuspjelo montiranje javlja se u prednjem planu (zadano)."

msgid "Client IP advertised for NFSv4.0 callbacks."
msgstr "IP adresa klijenta koja se objavljuje za NFSv4.0 povratne pozive."

msgid "Uses close-to-open cache coherence semantics."
msgstr "Koristi semantiku dosljednosti predmemorije close-to-open."

msgid "Disables close-to-open cache coherence."
msgstr "Onemogućuje dosljednost predmemorije close-to-open."

msgid "Caches read-only pages on local disk via FS-Cache."
msgstr "Predmemorira stranice samo za čitanje na lokalni disk putem FS-Cache."

msgid "Disables FS-Cache local disk caching."
msgstr "Onemogućuje FS-Cache predmemoriranje na lokalnom disku."

msgid "Retries requests indefinitely after server timeouts."
msgstr "Beskonačno ponavlja zahtjeve nakon isteka vremena poslužitelja."

msgid "Allow interrupts while hung; ignored after kernel 2.6.25."
msgstr "Dopušta prekide dok je zahtjev zaglavljen; zanemaruje se nakon jezgre 2.6.25."

msgid "Don't allow interrupts; ignored after kernel 2.6.25."
msgstr "Ne dopušta prekide; zanemaruje se nakon jezgre 2.6.25."

msgid "Treats flock/POSIX locks as local only."
msgstr "Tretira flock/POSIX zaključavanja kao isključivo lokalna."

msgid "Uses the NLM protocol to lock files on the server."
msgstr "Koristi NLM protokol za zaključavanje datoteka na poslužitelju."

msgid "Don't use NLM locking; locks are local only."
msgstr "Ne koristi NLM zaključavanje; zaključavanja su isključivo lokalna."

msgid "Directory-entry cache mode: all, none, pos or positive."
msgstr "Način predmemorije unosa direktorija: all, none, pos ili positive."

msgid "Max connections to IPs of one NFSv4.1+ server."
msgstr "Najveći broj veza prema IP adresama jednog NFSv4.1+ poslužitelja."

msgid "Uses TSM-compatible ID for NFSv4 migration."
msgstr "Koristi TSM-kompatibilan ID za NFSv4 migraciju."

msgid "Uses legacy client ID string (default)."
msgstr "Koristi zastarijeli niz ID-a klijenta (zadano)."

msgid "NFSv4 protocol minor version number."
msgstr "Broj sporedne inačice NFSv4 protokola."

msgid "Hostname running the mountd service."
msgstr "Naziv domaćina koji pokreće mountd uslugu."

msgid "Port of the server's mountd service."
msgstr "Ulaz mountd usluge poslužitelja."

msgid "Transport used to contact mountd (udp/tcp)."
msgstr "Prijenosni protokol za kontakt s mountd uslugom (udp/tcp)."

msgid "RPC version used to contact mountd."
msgstr "RPC inačica korištena za kontakt s mountd uslugom."

msgid "Maximum length of a pathname component."
msgstr "Najveća duljina komponente putanje."

msgid "Number of connections to establish to the server."
msgstr "Broj veza koje se uspostavljaju s poslužiteljem."

msgid "NFS protocol version (synonym of vers)."
msgstr "Inačica NFS protokola (sinonim za vers)."

msgid "Disables rounding buffered writes to page boundaries."
msgstr "Onemogućuje zaokruživanje međuspremnih pisanja na granice stranica."

msgid "Disables READDIRPLUS requests."
msgstr "Onemogućuje READDIRPLUS zahtjeve."

msgid "Port of the server's NFS service."
msgstr "Ulaz NFS usluge poslužitelja."

msgid "Transport protocol: udp, tcp or rdma."
msgstr "Protokol prijenosa: udp, tcp ili rdma."

msgid "Uses RDMA transport (synonym for proto=rdma)."
msgstr "Koristi RDMA prijenos (sinonim za proto=rdma)."

msgid "Enables READDIRPLUS requests."
msgstr "Omogućuje READDIRPLUS zahtjeve."

msgid "Uses privileged source ports (default)."
msgstr "Koristi privilegovane izvorne ulaze (zadano)."

msgid "Uses non-privileged source ports."
msgstr "Koristi neprivilegovane izvorne ulaze."

msgid "Number of retries before further recovery action."
msgstr "Broj ponovnih pokušaja prije daljnjih radnji oporavka."

msgid "Minutes to retry a failed mount before giving up."
msgstr "Broj minuta ponovnog pokušaja neuspjelog montiranja prije odustajanja."

msgid "Maximum bytes per network read request."
msgstr "Najviše bajtova po mrežnom zahtjevu za čitanje."

msgid "Maximum bytes per network write request."
msgstr "Najviše bajtova po mrežnom zahtjevu za pisanje."

msgid "Security flavors: none, sys, krb5, krb5i or krb5p."
msgstr "Sigurnosne varijante: none, sys, krb5, krb5i ili krb5p."

msgid "Shares one data/attribute cache across mounts."
msgstr "Dijeli jednu predmemoriju podataka/atributa između montiranja."

msgid "Gives each mount its own cache."
msgstr "Svakom montiranju daje vlastitu predmemoriju."

msgid "Ignores unrecognized mount options."
msgstr "Zanemaruje neprepoznate opcije montiranja."

msgid "Returns EIO after retrans retries."
msgstr "Vraća EIO nakon retrans ponovnih pokušaja."

msgid "Returns ETIMEDOUT after retrans retries."
msgstr "Vraća ETIMEDOUT nakon retrans ponovnih pokušaja."

msgid "Serves cached data when revalidation times out."
msgstr "Daje predmemorirane podatke kada istekne vrijeme ponovne provjere."

msgid "Don't fall back to cache when revalidation fails."
msgstr "Ne vraća se na predmemoriju kada ponovna provjera ne uspije."

msgid "Uses TCP transport (synonym for proto=tcp)."
msgstr "Koristi TCP prijenos (sinonim za proto=tcp)."

msgid "Deciseconds to wait before retrying a request."
msgstr "Broj decisekundi čekanja prije ponovnog slanja zahtjeva."

msgid "Probes NFSv4.1 session trunking on new mounts."
msgstr "Ispituje NFSv4.1 session trunking na novim montiranjima."

msgid "Disables session trunking discovery (default)."
msgstr "Onemogućuje otkrivanje session trunkinga (zadano)."

msgid "Uses UDP transport (synonym for proto=udp)."
msgstr "Koristi UDP prijenos (sinonim za proto=udp)."

msgid "NFS protocol version (alternative to nfsvers)."
msgstr "Inačica NFS protokola (alternativa nfsvers)."

msgid "Transport security policy: none, tls or mtls."
msgstr "Politika sigurnosti prijenosa: none, tls ili mtls."

msgid "Automatically reconnects if the connection is interrupted."
msgstr "Automatski se ponovno povezuje ako se veza prekine."

msgid "Delays connecting until the mountpoint is first accessed."
msgstr "Odgađa povezivanje do prvog pristupa točki montiranja."

msgid "Synchronous writes; slower but more reliable."
msgstr "Sinkrona pisanja; sporija, ali pouzdanija."

msgid "Disables speculative read-ahead beyond requested data."
msgstr "Onemogućuje spekulativno predčitavanje izvan zatraženih podataka."

msgid "Synchronous readdir; slower but more reliable."
msgstr "Sinkron readdir; sporiji, ali pouzdaniji."

msgid "Enables workarounds for broken SFTP servers."
msgstr "Omogućuje zaobilazna rješenja za neispravne SFTP poslužitelje."

msgid "UID/GID mapping mode: none, user or file."
msgstr "Način UID/GID mapiranja: none, user ili file."

msgid "File of username:uid mappings for idmap=file."
msgstr "Datoteka mapiranja username:uid za idmap=file."

msgid "File of groupname:gid mappings for idmap=file."
msgstr "Datoteka mapiranja groupname:gid za idmap=file."

msgid "Handles missing idmap entries: ignore or error."
msgstr "Rukovanje nedostajućim idmap unosima: ignore ili error."

msgid "Command to run instead of ssh."
msgstr "Naredba za pokretanje umjesto ssh."

msgid "SSH protocol version to use (default 2)."
msgstr "Inačica SSH protokola za korištenje (zadano 2)."

msgid "Path to the sftp server or subsystem."
msgstr "Putanja do sftp poslužitelja ili podsustava."

msgid "Connects directly to a port, bypassing SSH."
msgstr "Povezuje se izravno na ulaz, zaobilazeći SSH."

msgid "Connects via vsock to CID:PORT, bypassing SSH."
msgstr "Povezuje se putem vsock-a na CID:PORT, zaobilazeći SSH."

msgid "Communicates over stdin/stdout, bypassing the network."
msgstr "Komunicira putem stdin/stdout-a, zaobilazeći mrežu."

msgid "Makes link(2) fail with ENOSYS."
msgstr "Uzrokuje neuspjeh link(2) s ENOSYS greškom."

msgid "Turns absolute symlinks relative on the client."
msgstr "Pretvara apsolutne simboličke poveznice u relativne na klijentu."

msgid "Presents server symlinks as regular files."
msgstr "Prikazuje simboličke poveznice poslužitelja kao obične datoteke."

msgid "Don't check that the remote directory exists."
msgstr "Ne provjerava postoji li udaljeni direktorij."

msgid "Reads the password from stdin (for pam_mount only)."
msgstr "Čita lozinku iz stdin-a (samo za pam_mount)."

msgid "Enables or disables the SSHFS directory cache."
msgstr "Omogućuje ili onemogućuje SSHFS predmemoriju direktorija."

msgid "Maximum size of the directory cache."
msgstr "Najveća veličina predmemorije direktorija."

msgid "Timeout in seconds for the directory cache."
msgstr "Istek vremena u sekundama za predmemoriju direktorija."

msgid "Timeout for cached attributes."
msgstr "Istek vremena za predmemorirane atribute."

msgid "Timeout for cached symlinks."
msgstr "Istek vremena za predmemorirane simboličke poveznice."

msgid "Timeout for cached directory names."
msgstr "Istek vremena za predmemorirane nazive direktorija."

msgid "Interval for cleaning the directory cache."
msgstr "Interval čišćenja predmemorije direktorija."

msgid "Interval for forced cleaning when full."
msgstr "Interval prisilnog čišćenja kada je predmemorija puna."

msgid "Disables the kernel page cache for file content."
msgstr "Onemogućuje predmemoriju stranica jezgre za sadržaj datoteka."

msgid "Maximum number of simultaneous SSH connections."
msgstr "Najveći broj istovremenih SSH veza."

msgid "Allows all users to access the mount."
msgstr "Dopušta svim korisnicima pristup montiranju."

msgid "Allows root access in addition to the mounter."
msgstr "Dopušta root pristup uz korisnika koji je montirao."

msgid "Unmounts automatically when the process exits."
msgstr "Automatski odmontira kada proces završi."

msgid "Lets the kernel enforce permission checks."
msgstr "Dopušta jezgri provođenje provjera dozvola."

msgid "Caches file data in kernel without invalidation on open."
msgstr "Predmemorira podatke datoteka u jezgri bez poništavanja pri otvaranju."

msgid "Invalidates kernel data cache when file mtime changes."
msgstr "Poništava predmemoriju podataka jezgre kada se promijeni mtime datoteke."

msgid "Uses filesystem-provided inode numbers."
msgstr "Koristi brojeve inoda koje pruža datotečni sustav."

msgid "Allows mounting over non-empty directories (obsolete, now default)."
msgstr "Dopušta montiranje preko nepraznih direktorija (zastarjelo, sada zadano)."

msgid "Source string shown in /proc/mounts and mtab."
msgstr "Izvorni niz znakova prikazan u /proc/mounts i mtab."
msgid "Maximum size of read requests (bytes)."
msgstr "Maksimalna veličina zahtjeva za čitanje (u bajtovima)."

msgid "Maximum size of write requests (bytes)."
msgstr "Maksimalna veličina zahtjeva za pisanje (u bajtovima)."

msgid "Sets the block size to 512, 1024, or 2048."
msgstr "Postavlja veličinu bloka na 512, 1024 ili 2048."

msgid "Sets filename case checking (relaxed or strict)."
msgstr "Postavlja provjeru velikih i malih slova naziva datoteka (relaxed ili strict)."

msgid "Ignores high-order bits of file lengths (files limited to 16 MB)."
msgstr "Zanemaruje više bitove duljina datoteka (datoteke su ograničene na 16 MB)."

msgid "Group ID given to all files."
msgstr "ID grupe dodijeljen svim datotekama."

msgid "Charset converting Joliet Unicode names to 8-bit characters."
msgstr "Znakovni skup koji pretvara Joliet Unicode nazive u 8-bitne znakove."

msgid "Sets non-Rock Ridge name translation (normal, off, or acorn)."
msgstr "Postavlja prijevod naziva bez Rock Ridgea (normal, off ili acorn)."

msgid "Sets default permission mode for non-Rock Ridge files."
msgstr "Postavlja zadani način dozvola za datoteke bez Rock Ridgea."

msgid "Disables Microsoft Joliet extensions."
msgstr "Onemogućuje Microsoftova Joliet proširenja."

msgid "Disables Rock Ridge extensions."
msgstr "Onemogućuje Rock Ridge proširenja."

msgid "Sets the sector where the session begins."
msgstr "Postavlja sektor na kojemu počinje sesija."

msgid "Selects the session on a multisession CD."
msgstr "Odabire sesiju na CD-u s više sesija."

msgid "User ID given to all files."
msgstr "ID korisnika dodijeljen svim datotekama."

msgid "Shows hidden and associated files."
msgstr "Prikazuje skrivene i pridružene datoteke."

msgid "Converts 16-bit Unicode CD names to UTF-8."
msgstr "Pretvara 16-bitne Unicode nazive s CD-a u UTF-8."

msgid "Embeds file data in the inode (default)."
msgstr "Ugrađuje podatke datoteke u inode (zadano)."

msgid "Disables embedding file data in the inode."
msgstr "Onemogućuje ugrađivanje podataka datoteke u inode."

msgid "Overrides the standard anchor location (default 256)."
msgstr "Nadjačava standardnu lokaciju sidra (zadano 256)."

msgid "Sets the block size."
msgstr "Postavlja veličinu bloka."

msgid "Sets default permission mode for directories."
msgstr "Postavlja zadani način dozvola za direktorije."

msgid "Unimplemented and ignored."
msgstr "Nije implementirano i zanemaruje se."

msgid "Sets the default group for all files."
msgstr "Postavlja zadanu grupu za sve datoteke."

msgid "Sets the NLS character set for filenames."
msgstr "Postavlja NLS znakovni skup za nazive datoteka."

msgid "Sets the last block of the filesystem."
msgstr "Postavlja posljednji blok datotečnog sustava."

msgid "Uses long UDF address descriptors (default)."
msgstr "Koristi duge adresne deskriptore UDF-a (zadano)."

msgid "Sets default permission mode for non-directory files."
msgstr "Postavlja zadani način dozvola za datoteke koje nisu direktoriji."

msgid "Unsets strict UDF conformance."
msgstr "Poništava strogo pridržavanje UDF standarda."

msgid "Skips volume recognition sequence and mounts anyway."
msgstr "Preskače niz prepoznavanja volumena i svejedno montira."

msgid "Selects the session on multisession optical media."
msgstr "Odabire sesiju na optičkom mediju s više sesija."

msgid "Uses short UDF address descriptors."
msgstr "Koristi kratke adresne deskriptore UDF-a."

msgid "Sets the default user for all files."
msgstr "Postavlja zadanog korisnika za sve datoteke."

msgid "Masks out permissions from all inodes read."
msgstr "Maskira dozvole iz svih pročitanih inodea."

msgid "Shows deleted files in listings."
msgstr "Prikazuje izbrisane datoteke u popisima."

msgid "Shows otherwise hidden files."
msgstr "Prikazuje inače skrivene datoteke."

msgid "Uses the UTF-8 character set."
msgstr "Koristi znakovni skup UTF-8."

msgid "Sets initial group ID of the root directory."
msgstr "Postavlja početni ID grupe korijenskog direktorija."

msgid "Huge-page policy for files: never, always, within_size, advise."
msgstr "Pravilo velikih stranica za datoteke: never, always, within_size, advise."

msgid "Sets initial permissions of the root directory."
msgstr "Postavlja početne dozvole korijenskog direktorija."

msgid "Sets NUMA memory allocation policy for all files."
msgstr "Postavlja pravilo dodjele NUMA memorije za sve datoteke."

msgid "Disables swap; files cannot be swapped out."
msgstr "Onemogućuje swap; datoteke se ne mogu izbacivati u swap."

msgid "Same as size, but expressed in blocks of PAGE_SIZE."
msgstr "Isto kao size, ali izraženo u blokovima od PAGE_SIZE."

msgid "Maximum number of inodes for this instance."
msgstr "Maksimalan broj inodea za ovu instancu."

msgid "Upper size limit, e.g. 8m or 50%; 0 removes the limit."
msgstr "Gornja granica veličine, npr. 8m ili 50%; 0 uklanja ograničenje."

msgid "Sets initial user ID of the root directory."
msgstr "Postavlja početni ID korisnika korijenskog direktorija."

msgid "Group whose members bypass hidepid access restrictions."
msgstr "Grupa čiji članovi zaobilaze ograničenja pristupa hidepid."

msgid "Hides /proc/pid entries: 0 off, 1 own dirs, 2 other PIDs invisible."
msgstr "Skriva unose /proc/pid: 0 isključeno, 1 vlastiti direktoriji, 2 ostali PID-ovi nevidljivi."

msgid "Selects the PID namespace used to translate PIDs (new in 6.16)."
msgstr "Odabire prostor naziva PID-ova koji se koristi za prevođenje PID-ova (novo u 6.16)."

msgid "Shows only the pid subset, hiding other top-level proc files."
msgstr "Prikazuje samo pid podskup, a skriva ostale proc datoteke najviše razine."

msgid "Sets group of newly created pseudo-terminals."
msgstr "Postavlja grupu novostvorenih pseudo-terminala."

msgid "Limits the number of pseudo-terminals in this instance."
msgstr "Ograničava broj pseudo-terminala u ovoj instanci."

msgid "Sets permissions of newly created pseudo-terminals."
msgstr "Postavlja dozvole novostvorenih pseudo-terminala."

msgid "Creates a private instance with independent pty index space."
msgstr "Stvara privatnu instancu s neovisnim prostorom pty indeksa."

msgid "Sets the mode of the instance's ptmx device node."
msgstr "Postavlja način rada ptmx čvora uređaja instance."

msgid "Sets owner of newly created pseudo-terminals."
msgstr "Postavlja vlasnika novostvorenih pseudo-terminala."

msgid "Favors dynamic cgroup changes over hot-path fork/exit costs."
msgstr "Daje prednost dinamičkim promjenama cgroupa naspram troška fork/exit operacija na kritičnom putu."

msgid "Counts HugeTLB usage in memory controller accounting."
msgstr "Uračunava HugeTLB upotrebu u evidenciju memorijskog kontrolera."

msgid "Reports only local memory.events, excluding subtree counts."
msgstr "Prikazuje samo lokalne memory.events, isključujući zbrojeve podstabala."

msgid "Applies memory.min/low protection recursively to subtrees."
msgstr "Primjenjuje zaštitu memory.min/low rekurzivno na podstabla."

msgid "Treats cgroup namespaces as delegation boundaries."
msgstr "Tretira prostore naziva cgroupa kao granice delegiranja."

msgid "Counts only local fork failures in pids.events.max."
msgstr "Uračunava samo lokalne fork neuspjehe u pids.events.max."

msgid "Sets the group of the debugfs mount."
msgstr "Postavlja grupu debugfs montiranja."

msgid "Sets permissions of the mountpoint."
msgstr "Postavlja dozvole točke montiranja."

msgid "Sets the owner of the debugfs mount."
msgstr "Postavlja vlasnika debugfs montiranja."

msgid "Sets the group of the tracefs mount."
msgstr "Postavlja grupu tracefs montiranja."

msgid "Sets the owner of the tracefs mount."
msgstr "Postavlja vlasnika tracefs montiranja."

msgid "Sets group of the filesystem root."
msgstr "Postavlja grupu korijena datotečnog sustava."

msgid "Reserves a minimum of huge-page memory; mount fails if short."
msgstr "Rezervira minimalnu količinu memorije velikih stranica; ako je nema dovoljno, montiranje ne uspijeva."

msgid "Sets permissions of the filesystem root."
msgstr "Postavlja dozvole korijena datotečnog sustava."

msgid "Maximum number of inodes the filesystem can use."
msgstr "Maksimalan broj inodea koje datotečni sustav može koristiti."

msgid "Uses the given huge-page size for this mount."
msgstr "Koristi navedenu veličinu velikih stranica za ovo montiranje."

msgid "Maximum huge-page memory the filesystem may use."
msgstr "Maksimalna memorija velikih stranica koju datotečni sustav smije koristiti."

msgid "Sets owner of the filesystem root."
msgstr "Postavlja vlasnika korijena datotečnog sustava."

msgid "Access mode: user, <uid>, any or client."
msgstr "Način pristupa: user, <uid>, any ili client."

msgid "Authentication fid used by Plan 9 security."
msgstr "Fid za autentifikaciju koji koristi Plan 9 sigurnost."

msgid "File tree to access on the server."
msgstr "Stablo datoteka kojem se pristupa na poslužitelju."

msgid "Caching policy: none, readahead, mmap, loose or fscache."
msgstr "Pravilo predmemoriranja: none, readahead, mmap, loose ili fscache."

msgid "Tag for the persistent fscache."
msgstr "Oznaka trajne fscache predmemorije."

msgid "Debug level as a bitmask."
msgstr "Razina otklanjanja grešaka kao bitovna maska."

msgid "Attempts to mount with this gid."
msgstr "Pokušava montirati s ovim gid-om."

msgid "Attempts to mount as this uid."
msgstr "Pokušava montirati kao ovaj uid."

msgid "Bypasses the page cache on all reads/writes."
msgstr "Zaobilazi predmemoriju stranica kod svakog čitanja/pisanja."

msgid "Ignores qid.version==0 as a cache marker."
msgstr "Zanemaruje qid.version==0 kao oznaku predmemorije."

msgid "Bytes used for 9p packet payload."
msgstr "Broj bajtova za korisni teret 9p paketa."

msgid "Ms to retain negative dentries in cache."
msgstr "Milisekunde zadržavanja negativnih dentryja u predmemoriji."

msgid "Forces legacy 9p2000 mode (no extensions)."
msgstr "Forsira zastarjeli 9p2000 način rada (bez proširenja)."

msgid "Don't map special files; shows them as normal files."
msgstr "Ne preslikava posebne datoteke; prikazuje ih kao obične datoteke."

msgid "Don't offer xattr functions on this mount."
msgstr "Ne nudi xattr funkcije na ovom montiranju."

msgid "Port to connect to on the remote server."
msgstr "Ulazna vrata za povezivanje s udaljenim poslužiteljem."

msgid "File descriptor for reading with trans=fd."
msgstr "Opisnik datoteke za čitanje uz trans=fd."

msgid "Transport: unix, tcp, fd, virtio, rdma or usbg."
msgstr "Prijenos: unix, tcp, fd, virtio, rdma ili usbg."

msgid "User name to mount as on the server."
msgstr "Korisničko ime pod kojim se montira na poslužitelju."

msgid "9p protocol version: 9p2000, 9p2000.u or 9p2000.L."
msgstr "Inačica protokola 9p: 9p2000, 9p2000.u ili 9p2000.L."

msgid "File descriptor for writing with trans=fd."
msgstr "Opisnik datoteke za pisanje uz trans=fd."

msgid "Appends a data-only lower layer directory (new mount API)."
msgstr "Dodaje direktorij donjeg sloja samo s podacima (novi API za montiranje)."

msgid "Controls fsync during copy-up: auto, strict, or volatile."
msgstr "Upravlja fsync-om tijekom copy-up: auto, strict ili volatile."

msgid "Use an index to avoid inode collisions: on or off."
msgstr "Koristi indeks radi izbjegavanja sudara inodea: on ili off."

msgid "Colon-separated list of lower-layer directories."
msgstr "Popis direktorija donjeg sloja odvojenih dvotočkom."

msgid "Copy up only metadata first, deferring data copy: on or off."
msgstr "Najprije kopira samo metapodatke, odgađajući kopiranje podataka: on ili off."

msgid "Make the overlay mountable via NFS: on or off."
msgstr "Omogućuje montiranje overlaya putem NFS-a: on ili off."

msgid "Record the caller's credentials for permission checks."
msgstr "Zapisuje vjerodajnice pozivatelja radi provjere dozvola."

msgid "Redirect directories on rename: on, off, follow, or nofollow."
msgstr "Preusmjerava direktorije pri preimenovanju: on, off, follow ili nofollow."

msgid "Directory used as the upper (writable) layer."
msgstr "Direktorij koji služi kao gornji sloj (za pisanje)."

msgid "Use the user.overlay.* xattr namespace instead of trusted.overlay.*."
msgstr "Koristi user.overlay.* xattr prostor naziva umjesto trusted.overlay.*."

msgid "Control the overlay UUID and fsid: null, off, on, or auto."
msgstr "Upravlja UUID-om i fsid-om overlaya: null, off, on ili auto."

msgid "Verify metacopy digests with fs-verity: off, on, or require."
msgstr "Provjerava metacopy sažetke pomoću fs-verity: off, on ili require."

msgid "Prefer performance over durability; data not crash-safe."
msgstr "Prednost daje performansama umjesto trajnosti; podaci nisu otporni na pad sustava."

msgid "Scratch directory on the same filesystem as upperdir."
msgstr "Privremeni radni direktorij na istom datotečnom sustavu kao upperdir."

msgid "Appends an additional work directory (new mount API)."
msgstr "Dodaje dodatni radni direktorij (novi API za montiranje)."

msgid "Compose unique inode numbers across layers: on, off, or auto."
msgstr "Stvara jedinstvene brojeve inodea u svim slojevima: on, off ili auto."

msgid "Enable access control lists (legacy alias for acltype)."
msgstr "Omogućuje popise kontrole pristupa (zastarjeli alias za acltype)."

msgid "Disable ACLs (alias for acltype=off)."
msgstr "Onemogućuje ACL-ove (alias za acltype=off)."

msgid "Select ACL type: off, nfsv4, or posix."
msgstr "Odabire vrstu ACL-a: off, nfsv4 ili posix."

msgid "Enable mandatory locking (alias for nbmand=on)."
msgstr "Omogućuje obvezno zaključavanje (alias za nbmand=on)."

msgid "Disable mandatory locking (alias for nbmand=off)."
msgstr "Onemogućuje obvezno zaključavanje (alias za nbmand=off)."

msgid "Mount with non-blocking mandatory locks."
msgstr "Montira s neblokirajućim obveznim bravama."

msgid "Allow mounting over a non-empty or busy directory."
msgstr "Dopušta montiranje preko nepraznog ili zauzetog direktorija."

msgid "Enable POSIX ACLs (alias for acltype=posix)."
msgstr "Omogućuje POSIX ACL-ove (alias za acltype=posix)."

msgid "Disable relative access-time updates (plain atime)."
msgstr "Onemogućuje relativna ažuriranja vremena pristupa (obični atime)."

msgid "Enable extended attributes."
msgstr "Omogućuje proširene atribute."

msgid "Disable extended attributes."
msgstr "Onemogućuje proširene atribute."

msgid "Private flag marking the mount as managed by ZFS."
msgstr "Privatna zastavica koja označava da montiranjem upravlja ZFS."

msgid "Compression type used for background (rebalance) writes."
msgstr "Vrsta kompresije za pisanja u pozadini (rebalansiranje)."

msgid "Target device/label to move data to in the background."
msgstr "Ciljni uređaj/natpis na koji se podaci premještaju u pozadini."

msgid "Compression type used for foreground writes."
msgstr "Vrsta kompresije za pisanja u prvom planu."

msgid "Checksum type used for data writes."
msgstr "Vrsta kontrolne sume za pisanja podataka."

msgid "Number of replicas to keep for user data."
msgstr "Broj replika koje se čuvaju za korisničke podatke."

msgid "Allows mounting with data degraded (missing a replica)."
msgstr "Dopušta montiranje s degradiranim podacima (nedostaje replika)."

msgid "Allows mounting even when data would be missing."
msgstr "Dopušta montiranje i kada bi podaci nedostajali."

msgid "Enables discard/TRIM support on member devices."
msgstr "Omogućuje podršku za discard/TRIM na članskim uređajima."

msgid "Enables erasure coding."
msgstr "Omogućuje erasure coding (kodiranje s brisanjem)."

msgid ""
"Action to take on filesystem inconsistency: continue, fix_safe, panic, or ro."
msgstr "Radnja pri nekonzistentnosti datotečnog sustava: continue, fix_safe, panic ili ro."

msgid "Fixes fsck errors without prompting during mount."
msgstr "Ispravlja fsck pogreške tijekom montiranja bez traženja potvrde."

msgid "Preferred target device/label for foreground writes."
msgstr "Preferirani ciljni uređaj/natpis za pisanja u prvom planu."

msgid "Runs fsck during mount."
msgstr "Pokreće fsck tijekom montiranja."

msgid "Enables inline data extents for small files (default on)."
msgstr "Omogućuje inline podatkovne ekstente za male datoteke (standardno uključeno)."

msgid "Restricts new inode numbers to 32 bits."
msgstr "Ograničava nove brojeve inodea na 32 bita."

msgid "Milliseconds before an automatic journal commit (default 1000)."
msgstr "Milisekunde do automatskog zapisivanja dnevnika (standardno 1000)."

msgid "Disables journal flush on sync/fsync."
msgstr "Onemogućuje pražnjenje dnevnika pri sync/fsync."

msgid "Milliseconds before automatic journal reclaim."
msgstr "Milisekunde prije automatskog oslobađanja dnevnika."

msgid "Checksum type used for metadata writes."
msgstr "Vrsta kontrolne sume za pisanja metapodataka."
msgid "Number of replicas to keep for metadata (journal and btree)."
msgstr "Broj replika koje treba čuvati za metapodatke (dnevnik i b-stablo)."

msgid "Preferred target device/label for metadata writes."
msgstr "Preferirani ciljni uređaj/oznaka za zapise metapodataka."

msgid ""
"Issues no writes at all, even for journal replay (super read-only mode)."
msgstr "Ne vrši nikakve zapise, čak ni za ponovnu primjenu dnevnika (super način rada samo za čitanje)."

msgid "Doesn't open member devices in exclusive mode."
msgstr "Ne otvara pripadajuće uređaje u isključivom načinu rada."

msgid "Does not replay the journal on mount (not recommended)."
msgstr "Ne primjenjuje dnevnik pri montiranju (nije preporučljivo)."

msgid "Target device/label data is copied to on read."
msgstr "Ciljni uređaj/oznaka u koji se kopiraju podaci pri čitanju."

msgid "Rate-limits error messages during fsck."
msgstr "Ograničava broj poruka o pogreškama tijekom fsck provjere."

msgid "Mounts the filesystem in read-only mode."
msgstr "Montira datotečni sustav u načinu rada samo za čitanje."

msgid "Uses the CPU id for the high bits of new inode numbers."
msgstr "Koristi ID procesora za više bitove brojeva novih inodea."

msgid "Hash function used for string hash tables (directories and xattrs)."
msgstr "Funkcija raspršivanja koja se koristi za hash tablice znakovnih nizova (direktorije i proširene atribute)."

msgid "Prints extra debugging info during mount/recovery."
msgstr "Ispisuje dodatne informacije za otklanjanje pogrešaka tijekom montiranja/oporavka."

msgid "Upgrades the on-disk format to the latest version on mount."
msgstr "Nadograđuje format na disku na najnoviju verziju pri montiranju."

msgid "Stores full 128-bit cryptographic MACs instead of the default 80-bit."
msgstr "Pohranjuje pune 128-bitne kriptografske MAC-ove umjesto zadanih 80-bitnih."

msgid "Enables group quotas."
msgstr "Omogućuje grupne kvote."

msgid "Enables project quotas."
msgstr "Omogućuje projektne kvote."

msgid "Enables user quotas."
msgstr "Omogućuje korisničke kvote."

msgid ""
"original non-journaling ext filesystem, still used for small boot partitions"
msgstr "izvorni ext datotečni sustav bez dnevnika, još se koristi za male boot particije"

msgid "ext2 with journaling added for crash-recovery reliability"
msgstr "ext2 s dodanim dnevnikom za pouzdan oporavak nakon pada sustava"

msgid ""
"default Linux journaling filesystem with extents and very large volume "
"support"
msgstr "zadani Linux datotečni sustav s dnevnikom, ekstenatima i podrškom za vrlo velike volumene"

msgid "copy-on-write filesystem with snapshots, subvolumes, and RAID"
msgstr "datotečni sustav s kopiranjem pri zapisivanju (copy-on-write) sa snimkama, podvolumenima i RAID-om"

msgid ""
"SGI-developed 64-bit journaling filesystem for high performance and large "
"files"
msgstr "SGI-jev 64-bitni dnevnički datotečni sustav za visoke performanse i velike datoteke"

msgid "flash-friendly filesystem designed for NAND flash storage"
msgstr "datotečni sustav prilagođen flash memoriji, dizajniran za NAND flash pohranu"

msgid "Linux kernel driver providing read/write access to Windows NTFS volumes"
msgstr "upravljački program Linux kernela koji pruža pristup Windows NTFS volumenima za čitanje i pisanje"

msgid "FAT filesystem variant with long filename support for removable media"
msgstr "varijanta FAT datotečnog sustava s podrškom za duga imena datoteka za prijenosne medije"

msgid "Microsoft filesystem for large removable drives and SD cards over 32 GB"
msgstr "Microsoftov datotečni sustav za velike prijenosne diskove i SD kartice veće od 32 GB"

msgid "disk space acting as virtual memory when physical RAM is exhausted"
msgstr "prostor na disku koji djeluje kao virtualna memorija kada se fizički RAM iscrpi"

msgid ""
"network filesystem using the SMB protocol for Windows and NAS file shares"
msgstr "mrežni datotečni sustav koji koristi SMB protokol za dijeljenja datoteka na Windows i NAS sustavima"

msgid "modern, secure dialect of SMB used for Windows, Azure, and NAS shares"
msgstr "moderan i siguran dijalekt SMB-a koji se koristi za dijeljenja na Windows, Azure i NAS sustavima"

msgid "network filesystem for sharing files across machines over the network"
msgstr "mrežni datotečni sustav za dijeljenje datoteka između računala putem mreže"

msgid "newer NFS version adding security, statefulness, and better locking"
msgstr "novija verzija NFS-a koja donosi sigurnost, očuvanje stanja i bolje zaključavanje"

msgid ""
"mounts a remote directory over SSH using SFTP, running in userspace via FUSE"
msgstr "montira udaljeni direktorij preko SSH-a pomoću SFTP-a, radi u korisničkom prostoru putem FUSE-a"

msgid "standard filesystem format for CD-ROM optical media"
msgstr "standardni format datotečnog sustava za CD-ROM optičke medije"

msgid "Universal Disk Format for writable optical discs like DVDs and Blu-rays"
msgstr "Universal Disk Format za optičke medije za zapisivanje poput DVD-a i Blu-raya"

msgid ""
"virtual filesystem storing files in RAM and swap for temporary in-memory data"
msgstr "virtualni datotečni sustav koji pohranjuje datoteke u RAM i swap za privremene podatke u memoriji"

msgid "virtual filesystem exposing kernel and process information as files"
msgstr "virtualni datotečni sustav koji izlaže informacije o kernelu i procesima kao datoteke"

msgid ""
"virtual filesystem exposing kernel objects, devices, and their attributes to "
"userspace"
msgstr "virtualni datotečni sustav koji izlaže objekte kernela, uređaje i njihove atribute korisničkom prostoru"

msgid ""
"virtual filesystem providing pseudo-terminal device nodes under /dev/pts"
msgstr "virtualni datotečni sustav koji pruža čvorove pseudo-terminalskih uređaja pod /dev/pts"

msgid ""
"virtual filesystem for the unified cgroup v2 hierarchy, managing resource "
"limits and accounting"
msgstr "virtualni datotečni sustav za objedinjenu cgroup v2 hijerarhiju, upravlja ograničenjima resursa i njihovim praćenjem"

msgid ""
"virtual filesystem backing security modules such as SELinux and IMA "
"integrity interfaces"
msgstr "virtualni datotečni sustav koji podupire sigurnosne module poput SELinuxa i IMA sučelja integriteta"

msgid ""
"virtual filesystem exporting arbitrary kernel debugging data with no ABI "
"stability guarantees"
msgstr "virtualni datotečni sustav koji izvozi proizvoljne podatke kernela za otklanjanje pogrešaka bez jamstava ABI stabilnosti"

msgid ""
"virtual filesystem holding ftrace control and trace-output files under /sys/"
"kernel/tracing"
msgstr "virtualni datotečni sustav koji sadrži ftrace kontrolne datoteke i datoteke s tragovima pod /sys/kernel/tracing"

msgid ""
"virtual filesystem where userspace creates and configures kernel objects via "
"mkdir and rmdir"
msgstr "virtualni datotečni sustav u kojem korisnički prostor stvara i konfigurira objekte kernela putem mkdir i rmdir"

msgid "POSIX message queue IPC exposed as files at /dev/mqueue"
msgstr "POSIX redovi poruka (IPC) izloženi kao datoteke na /dev/mqueue"

msgid "interface to huge page memory, mounted at /dev/hugepages"
msgstr "sučelje prema memoriji velikih stranica, montirano na /dev/hugepages"

msgid "populates /dev with device nodes automatically at boot"
msgstr "automatski puni /dev čvorovima uređaja pri pokretanju"

msgid "Plan 9 remote filesystem protocol, used for host-to-VM file sharing"
msgstr "protokol udaljenog datotečnog sustava Plan 9, koristi se za dijeljenje datoteka između domaćina i virtualnih strojeva"

msgid "union filesystem stacking upper/lower layers, used by containers"
msgstr "union datotečni sustav koji slaže gornje/donje slojeve, koriste ga kontejneri"

msgid "OpenZFS copy-on-write filesystem with integrated volume management"
msgstr "OpenZFS datotečni sustav s kopiranjem pri zapisivanju i integriranim upravljanjem volumenima"

msgid ""
"copy-on-write, multi-device filesystem with built-in caching, compression, "
"and checksumming"
msgstr "višeuređajni datotečni sustav s kopiranjem pri zapisivanju, ugrađenim predmemoriranjem, kompresijom i kontrolnim zbrojevima"

msgid "a custom filesystem type"
msgstr "prilagođena vrsta datotečnog sustava"

msgid "Other"
msgstr "Ostalo"

msgid "Other…"
msgstr "Ostalo…"

msgid "Search filesystems"
msgstr "Traži datotečne sustave"

msgid "Choose the filesystem type"
msgstr "Odaberite vrstu datotečnog sustava"

msgid "Error loading filesystem types"
msgstr "Pogreška pri učitavanju vrsta datotečnih sustava"

msgid "File system:"
msgstr "Datotečni sustav:"

msgid "File system"
msgstr "Datotečni sustav"

msgid "Make backup"
msgstr "Stvori kopiju"

msgid "Save changes"
msgstr "Spremi promjene"

msgid "Revert changes"
msgstr "Poništi promjene"

msgid ""
"Your changes have not been saved yet. The backup will reflect the saved /etc/"
"fstab, not your unsaved changes. Continue?"
msgstr ""
"Vaše promjene još nisu spremljene. Sigurnosna kopija odražavat će spremljenu "
"/etc/fstab, a ne vaše nespremljene promjene. Nastaviti?"

msgid "Are you sure you want to write these changes to /etc/fstab?"
msgstr "Jeste li sigurni da želite zapisati ove promjene u /etc/fstab?"

msgid "Saved, but could not reload"
msgstr "Spremljeno, ali nije moguće ponovno učitati"

msgid "Saved to /etc/fstab"
msgstr "Spremljeno u /etc/fstab"

msgid "Could not save"
msgstr "Nije moguće spremiti"

msgid "Revert"
msgstr "Poništi"

msgid "Are you sure? Any changes made will be lost!"
msgstr "Jeste li sigurni? Sve napravljene promjene bit će izgubljene!"

msgid "'/etc/fstab' entries:"
msgstr "Unosi u '/etc/fstab':"

msgid "Error loading fstab file!"
msgstr "Pogreška pri učitavanju fstab datoteke!"

msgid "Backup created"
msgstr "Sigurnosna kopija je stvorena"

msgid "A backup of /etc/fstab was created."
msgstr "Stvorena je sigurnosna kopija /etc/fstab."

msgid "Could not create backup"
msgstr "Nije moguće stvoriti sigurnosnu kopiju"

msgid "This entry is disabled (commented out)."
msgstr "Ovaj unos je onemogućen (zakomentiran)."

msgid ""
"The system may refuse to boot without this drive. If this is not intended, "
"add the 'nofail' option. \n"
"Usually, this is wanted on root and home mounts."
msgstr ""
"Sustav može odbiti pokretanje bez ovog uređaja. Ako to nije namjera, dodajte "
"opciju 'nofail'. \n"
"Obično je to poželjno kod root i home particija."

msgid "This entry is invalid and cannot be parsed."
msgstr "Ovaj unos je neispravan i ne može se obraditi."

msgid "Add new mount entry"
msgstr "Dodaj novi unos za montiranje"

msgid "Restore"
msgstr "Vrati"

msgid "Restore backup"
msgstr "Vrati kopiju"

msgid "Search backups"
msgstr "Traži sigurnosne kopije"

msgid "Restore from a backup file"
msgstr "Vrati iz datoteke sigurnosne kopije"

msgid "Failed to list backups"
msgstr "Nije moguće dohvatiti popis sigurnosnih kopija"

msgid "Could not load backup"
msgstr "Nije moguće učitati sigurnosnu kopiju"

msgid "Cannot remount"
msgstr "Nije moguće ponovno montirati"

msgid "Cannot unmount"
msgstr "Nije moguće odmontirati"

msgid "The entry has unsaved changes. Save your changes before mounting."
msgstr "Unos ima nespremljene promjene. Spremite promjene prije montiranja."

msgid "The entry has unsaved changes. Save your changes before remounting."
msgstr "Unos ima nespremljene promjene. Spremite promjene prije ponovnog montiranja."

msgid ""
"The mount point has unsaved changes. Save your changes before unmounting."
msgstr "Točka montiranja ima nespremljene promjene. Spremite promjene prije odmontiranja."

msgid "The mount point is empty."
msgstr "Točka montiranja je prazna."

msgid "Delete entry"
msgstr "Izbriši unos"

msgid "Device"
msgstr "Uređaj"

msgid "Mount point"
msgstr "Točka montiranja"

msgid "Delete"
msgstr "Izbriši"

msgid "Delete this entry?"
msgstr "Izbrisati ovaj unos?"

msgid "Reset"
msgstr "Resetiraj"

msgid "Edit properties"
msgstr "Uredi svojstva"

msgid "Options"
msgstr "Opcije"

msgid "Active"
msgstr "Aktivna"

msgid "Extra"
msgstr "Dodatna"

msgid "Dump"
