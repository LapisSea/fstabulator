{
	"app-id": "org.lapissea.FSTabulator",
	"default-branch": "stable",
	"command": "fstabulator",
	"runtime": "org.gnome.Platform",
	"runtime-version": "50",
	"sdk": "org.gnome.Sdk",
	"separate-locales": false,
	"modules": [
		{
			"name": "fstabulator",
			"buildsystem": "simple",
			"sources": [
				{
					"type": "dir",
					"path": "flatpak/source"
				}
			],
			"build-commands": [
				"install -Dm 0755 fstabulator /app/bin/fstabulator",
				"install -Dm 0644 org.lapissea.FSTabulator.desktop /app/share/applications/org.lapissea.FSTabulator.desktop",
				"install -Dm 0644 resources/fstabulator_icon.svg /app/share/icons/hicolor/scalable/apps/org.lapissea.FSTabulator.svg",
				"for lang in locale/*; do [ -f \"$lang/LC_MESSAGES/fstabulator.mo\" ] || continue; install -d /app/share/locale/$(basename $lang)/LC_MESSAGES; install -m 0644 $lang/LC_MESSAGES/fstabulator.mo /app/share/locale/$(basename $lang)/LC_MESSAGES/fstabulator.mo; done"
			]
		}
	],
	"finish-args": [
		"--share=ipc",
		"--share=network",
		"--socket=wayland",
		"--socket=fallback-x11",
		"--device=dri",
		"--talk-name=org.freedesktop.PolicyKit1"
	]
}
